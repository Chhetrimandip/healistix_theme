{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "record_version": {
      "const": "1"
    },
    "recipe_digest": {
      "type": "string"
    },
    "build": {
      "type": "object",
      "properties": {
        "build_id": {
          "type": "string",
          "pattern": "^B-[A-Z2-7]{8}$"
        },
        "base": {
          "enum": [
            "gold-16oz"
          ]
        },
        "flavor": {
          "type": "object",
          "properties": {
            "id": {
              "enum": [
                "none",
                "banana",
                "blueberry",
                "dragonfruit",
                "grape",
                "honey",
                "honeydew",
                "lychee",
                "mango",
                "orange",
                "passion fruit",
                "peach",
                "pineapple",
                "pineapple mango",
                "red guava",
                "rose",
                "strawberry",
                "strawberry pineapple",
                "watermelon"
              ]
            },
            "level": {
              "enum": [
                "standard",
                "extra"
              ]
            }
          },
          "required": [
            "id",
            "level"
          ],
          "additionalProperties": false
        },
        "strength": {
          "enum": [
            "standard",
            "strong"
          ]
        },
        "herbs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "enum": [
                  "ashwagandha",
                  "maca",
                  "korean-red-ginseng",
                  "tongkat-ali",
                  "beet-root",
                  "ginger",
                  "turmeric",
                  "reishi",
                  "lions-mane",
                  "cordyceps",
                  "chaga",
                  "spirulina",
                  "chlorella",
                  "moringa",
                  "hibiscus",
                  "cinnamon",
                  "fenugreek",
                  "slippery-elm",
                  "marshmallow-root",
                  "fennel",
                  "peppermint",
                  "chamomile",
                  "lemon-balm",
                  "passionflower",
                  "holy-basil",
                  "rhodiola",
                  "shatavari",
                  "damiana",
                  "muira-puama",
                  "horny-goat-weed",
                  "sarsaparilla",
                  "burdock-root",
                  "dandelion-root",
                  "nettle-leaf",
                  "horsetail",
                  "amla",
                  "bladderwrack",
                  "elderberry",
                  "black-seed",
                  "cacao",
                  "matcha",
                  "bacopa",
                  "gotu-kola",
                  "boswellia",
                  "milk-thistle",
                  "mullein",
                  "red-raspberry-leaf",
                  "shilajit",
                  "ginkgo",
                  "saffron",
                  "licorice-root",
                  "cayenne"
                ]
              },
              "g": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 30
              }
            },
            "required": [
              "id",
              "g"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": false
        },
        "uses": {
          "type": "array",
          "items": {
            "enum": [
              "digestion",
              "skin-hair-nails",
              "energy",
              "vitality-men",
              "vitality-women",
              "stress",
              "sleep",
              "focus",
              "joints",
              "greens",
              "cleanse",
              "respiratory",
              "metabolism",
              "womens-balance",
              "recovery",
              "mood"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "total_powder_g": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "engine_version": {
          "type": "string"
        },
        "library_version": {
          "type": "string"
        }
      },
      "required": [
        "build_id",
        "base",
        "flavor",
        "strength",
        "herbs",
        "uses",
        "total_powder_g",
        "engine_version",
        "library_version"
      ],
      "additionalProperties": false
    },
    "pricing_version": {
      "type": "string"
    },
    "pricing": {
      "type": "object",
      "properties": {
        "currency": {
          "const": "USD"
        },
        "total_minor": {
          "type": "integer",
          "minimum": 0
        },
        "breakdown": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "quantity": {
                "type": "integer",
                "minimum": 0
              },
              "unit_minor": {
                "type": "integer",
                "minimum": 0
              },
              "total_minor": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "code",
              "label",
              "quantity",
              "unit_minor",
              "total_minor"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": false
        },
        "confirmed": {
          "const": false
        }
      },
      "required": [
        "currency",
        "total_minor",
        "breakdown",
        "confirmed"
      ],
      "additionalProperties": false
    },
    "approval_status": {
      "const": "provisional"
    }
  },
  "required": [
    "record_version",
    "recipe_digest",
    "build",
    "pricing_version",
    "pricing",
    "approval_status"
  ],
  "additionalProperties": false
}
