<section class="od-section od-section--deep od-origin">
  <div class="od-wrap od-origin__grid">
    <div class="od-origin__copy">
      {%- if section.settings.heading != blank -%}
        <h2 class="od-display od-display--md">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <p class="od-origin__statement">{{ section.settings.statement }}</p>

      {%- if section.settings.body != blank -%}
        <p class="od-body">{{ section.settings.body }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <div>
          <a class="od-btn od-btn--ghost" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
        </div>
      {%- endif -%}

      <dl class="od-origin__facts">
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign stat_num = section.settings.stat_1_number
                assign stat_label = section.settings.stat_1_label
              when 2
                assign stat_num = section.settings.stat_2_number
                assign stat_label = section.settings.stat_2_label
              when 3
                assign stat_num = section.settings.stat_3_number
                assign stat_label = section.settings.stat_3_label
            endcase
          -%}
          {%- if stat_num != blank -%}
            <div>
              <dt>{{ stat_num }}</dt>
              <dd>{{ stat_label }}</dd>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </dl>
    </div>

    <div class="od-origin__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(max-width: 880px) 100vw, 45vw' }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OD — Origin",
  "tag": "section",
  "class": "od-section-origin",
  "settings": [
    { "type": "text", "id": "heading", "label": "Eyebrow heading", "default": "Where it comes from" },
    {
      "type": "textarea",
      "id": "statement",
      "label": "Statement (use <em> to highlight a word in teal)",
      "default": "Pulled from the Atlantic by hand. <em>No shortcuts</em>, no middlemen, no mystery."
    },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "Every batch of Healistix sea moss is wildcrafted from the rocky shores of St. Lucia, dried in the sun, soaked in spring water, and blended the same week. Not imported from a warehouse. Not processed into a powder and reconstituted." },
    { "type": "image_picker", "id": "image", "label": "Founder or harvest photo" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Our story" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "header", "content": "Stat 1" },
    { "type": "text", "id": "stat_1_number", "label": "Number", "default": "92" },
    { "type": "text", "id": "stat_1_label", "label": "Label", "default": "minerals per jar" },
    { "type": "header", "content": "Stat 2" },
    { "type": "text", "id": "stat_2_number", "label": "Number", "default": "30+" },
    { "type": "text", "id": "stat_2_label", "label": "Label", "default": "flavors, always fresh" },
    { "type": "header", "content": "Stat 3" },
    { "type": "text", "id": "stat_3_number", "label": "Number", "default": "100%" },
    { "type": "text", "id": "stat_3_label", "label": "Label", "default": "hand-harvested" }
  ],
  "presets": [{ "name": "OD — Origin" }]
}
{% endschema %}
