{{ 'section-benefits-seamoss.css' | asset_url | stylesheet_tag }}

<div id="Benefits-{{ section.id }}" class="benefits-seamoss color-{{ section.settings.color_scheme }}">
  <div class="benefits-seamoss__container">
    <div class="benefits-seamoss__layout">
      <div class="benefits-seamoss__image-column">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" 
               alt="{{ section.settings.heading }}"
               class="benefits-seamoss__image"
               loading="lazy">
        {%- else -%}
          <div class="benefits-seamoss__image-placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'benefits-seamoss__image-placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
      
      <div class="benefits-seamoss__content-column">
        {%- if section.settings.heading != blank -%}
          <h2 class="benefits-seamoss__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        
        <div class="benefits-seamoss__grid">
          {%- for block in section.blocks -%}
            <div class="benefits-seamoss__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <div class="benefits-seamoss__icon-wrapper">
                  <span class="benefits-seamoss__icon">{{ block.settings.icon }}</span>
                </div>
              {%- endif -%}
              <div class="benefits-seamoss__text">
                {%- if block.settings.title != blank -%}
                  <h3 class="benefits-seamoss__title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="benefits-seamoss__description">{{ block.settings.description }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
  
  {%- if section.settings.show_badges and section.settings.badges != blank -%}
    <div class="benefits-seamoss__badges-bar">
      <div class="benefits-seamoss__badges-scroll">
        {{ section.settings.badges }}
        {{ section.settings.badges }}
      </div>
    </div>
  {%- endif -%}
</div>

{% style %}
  #Benefits-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Benefits Sea Moss",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One Ritual. All the Benefits."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product Image"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show badge bar",
      "default": true
    },
    {
      "type": "html",
      "id": "badges",
      "label": "Badges HTML",
      "default": "PALEO DIET <span>+</span> GLUTEN FREE <span>+</span> 100% VEGAN <span>+</span> NON GMO <span>+</span> DAIRY FREE <span>+</span> SOY FREE",
      "info": "Use + to separate badges"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon Emoji",
          "default": "🛡️"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Immune Support"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Helps maintain your body's natural defenses."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Sea Moss",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "🛡️",
            "title": "Immune Support",
            "description": "Helps maintain your body's natural defenses."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "💚",
            "title": "Gut Health",
            "description": "Aids digestive balance with natural prebiotic fibers."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "⚡",
            "title": "Energy Metabolism",
            "description": "Carries key minerals that help turn food into steady fuel."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "🔄",
            "title": "Daily Reset",
            "description": "Traditionally used to support gentle detox."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "🍽️",
            "title": "Balanced Eating",
            "description": "Helps maintain satiety and mindful eating habits."
          }
        }
      ]
    }
  ]
}
{% endschema %}
