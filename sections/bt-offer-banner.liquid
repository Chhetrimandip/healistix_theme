{{ 'batana-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'batana-page.js' | asset_url }}" defer></script>

<section class="bt-section bt-section--green bt-banner">
  <div class="bt-container">
    {%- if section.settings.eyebrow != blank -%}
      <div class="bt-banner__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h2 class="bt-banner__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}
      <div class="bt-banner__sub">{{ section.settings.subtext }}</div>
    {%- endif -%}
    <a href="{{ section.settings.button_link | default: '#batana-buy' }}" class="bt-btn bt-btn--light">{{ section.settings.button_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Batana — Offer banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NEW CUSTOMER OFFER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bundle up & save" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "LIMITED TIME" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "CLAIM OFFER" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the buy box on this page." }
  ],
  "presets": [{ "name": "Batana — Offer banner" }]
}
{% endschema %}
