{{ 'batana-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'batana-page.js' | asset_url }}" defer></script>

{%- assign features = section.blocks | where: 'type', 'feature' -%}

<section class="bt-section bt-features">
  <div class="bt-container">
    <h2 class="bt-h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="bt-features__lead">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="bt-features__items">
      {%- for block in features -%}
        <div class="bt-feature" {{ block.shopify_attributes }}>
          <div class="bt-feature__icon">
            {%- if block.settings.icon_image != blank -%}
              <img
                src="{{ block.settings.icon_image | image_url: width: 240 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="240"
                height="240"
              >
            {%- else -%}
              {%- comment -%} line-icon placeholder until an illustrated icon is uploaded {%- endcomment -%}
              {%- case block.settings.icon -%}
                {%- when 'drop' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.7C9 7 5.5 10.6 5.5 14.5a6.5 6.5 0 0 0 13 0C18.5 10.6 15 7 12 2.7z"/><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5"/></svg>
                {%- when 'sprout' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21v-9"/><path d="M12 12c0-4 3-7 7.5-7 0 4-3 7-7.5 7z"/><path d="M12 15c0-3.2-2.4-5.5-6-5.5 0 3.2 2.4 5.5 6 5.5z"/><path d="M7 21h10"/></svg>
                {%- when 'repair' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.5s-7.5-4.3-7.5-10A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 7.5 3.5c0 5.7-7.5 10-7.5 10z"/><path d="M9.5 12h1.7l1-2 1.6 4 1-2h1.7"/></svg>
                {%- when 'feather' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4c-6 0-12 5-13.5 12L5 21"/><path d="M20 4c1 5-2 11-8.5 12.5L7 17"/><path d="M20 4 8 16"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M8.8 12l2.2 2.2 4.2-4.7"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.3L19 10l-5.1 1.7L12 17l-1.9-5.3L5 10l5.1-1.7L12 3z"/><path d="M19 15l.9 2.4L22 18.5l-2.1 1.1L19 22l-.9-2.4L16 18.5l2.1-1.1L19 15z"/></svg>
              {%- endcase -%}
            {%- endif -%}
          </div>
          <h3 class="bt-feature__title">{{ block.settings.title }}</h3>
          <p class="bt-feature__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#batana-buy' }}" class="bt-btn bt-btn--gold">{{ section.settings.button_label }}</a>
    {%- endif -%}
    {%- if section.settings.note != blank -%}
      <div class="bt-features__note">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M14.5 9.3c-.4-.8-1.3-1.3-2.5-1.3-1.5 0-2.5.8-2.5 2 0 2.6 5.2 1.4 5.2 4 0 1.2-1 2-2.7 2-1.3 0-2.3-.6-2.7-1.5"/><path d="M12 6.5v11"/></svg>
        {{ section.settings.note }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Batana — Feature grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thousands of women choose our oil" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "ADD TO CART" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the buy box on this page." },
    { "type": "text", "id": "note", "label": "Note under button", "default": "60 DAY RESULTS OR MONEY BACK" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image",
          "info": "Square illustrated icon (e.g. from Midjourney/Gemini). Falls back to a simple line icon when empty."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback line icon",
          "options": [
            { "value": "drop", "label": "Oil drop (purity)" },
            { "value": "sprout", "label": "Sprout (growth)" },
            { "value": "repair", "label": "Heart pulse (restore)" },
            { "value": "feather", "label": "Feather (lightweight)" },
            { "value": "shield", "label": "Shield (protection)" },
            { "value": "sparkle", "label": "Sparkle (shine)" }
          ],
          "default": "drop"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "100% Pure Batana Oil" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Sourced directly from the American oil palm — no fillers or blends." }
      ]
    }
  ],
  "presets": [{ "name": "Batana — Feature grid" }]
}
{% endschema %}
