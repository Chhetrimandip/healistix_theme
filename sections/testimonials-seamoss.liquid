{{ 'section-testimonials-seamoss.css' | asset_url | stylesheet_tag }}

<div id="Testimonials-{{ section.id }}" class="testimonials-seamoss color-{{ section.settings.color_scheme }}">
  <div class="testimonials-seamoss__container page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="testimonials-seamoss__heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    
    <div class="testimonials-seamoss__grid">
      {%- for block in section.blocks -%}
        <div class="testimonials-seamoss__item" {{ block.shopify_attributes }}>
          <div class="testimonials-seamoss__logo-container">
            {%- if block.settings.logo != blank -%}
              <div class="testimonials-seamoss__logo">
                {{ block.settings.logo }}
              </div>
            {%- endif -%}
          </div>
          
          <div class="testimonials-seamoss__content">
            {%- if block.settings.quote != blank -%}
              <blockquote class="testimonials-seamoss__quote">
                {{ block.settings.quote }}
              </blockquote>
            {%- endif -%}
            
            <div class="testimonials-seamoss__rating">
              <span class="star">★</span>
              <span class="star">★</span>
              <span class="star">★</span>
              <span class="star">★</span>
              <span class="star">★</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  #Testimonials-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Testimonials Sea Moss",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured In"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "logo",
          "label": "Logo Text",
          "default": "Publication Name",
          "info": "Enter publication name (will be styled)"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Add your testimonial quote here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials Sea Moss",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "logo": "NEW YORK WEEKLY",
            "quote": "True Sea Moss, one of the leading providers of sea moss in the USA."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "logo": "YOUTH HEALTH",
            "quote": "The launch of True Sea Moss at Sprouts Farmers Market represents a celebration of health, wellness, and accessibility."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "logo": "BUSINESS INSIDER",
            "quote": "The product which is affordable to all customers while maintaining its commitment to naturalness, freshness, and customer service."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "logo": "THE GOOD MEN PROJECT",
            "quote": "True Sea Moss has made the Earth's true natural minerals available to everyone."
          }
        }
      ]
    }
  ]
}
{% endschema %}

