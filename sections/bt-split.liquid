{{ 'batana-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'batana-page.js' | asset_url }}" defer></script>

<section class="bt-section bt-section--deep">
  <div class="bt-container bt-center">
    <h2 class="bt-h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="bt-sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="bt-split__grid">
      <div class="bt-split__card">
        {%- if section.settings.bad_image != blank -%}
          <div class="bt-split__img">
            <img src="{{ section.settings.bad_image | image_url: width: 800 }}" alt="{{ section.settings.bad_title | escape }}" loading="lazy" width="800" height="500">
          </div>
        {%- endif -%}
        <div class="bt-split__inner">
          {%- if section.settings.bad_kicker != blank -%}
            <div class="bt-split__kicker">{{ section.settings.bad_kicker }}</div>
          {%- endif -%}
          <h3 class="bt-h3">{{ section.settings.bad_title }}</h3>
          <div class="bt-split__tags">
            {%- assign bad_tags = section.settings.bad_tags | split: '|' -%}
            {%- for tag in bad_tags -%}
              <span class="bt-split__tag">{{ tag | strip }}</span>
            {%- endfor -%}
          </div>
          <p>{{ section.settings.bad_text }}</p>
        </div>
      </div>
      <div class="bt-split__card bt-split__card--good">
        {%- if section.settings.good_image != blank -%}
          <div class="bt-split__img">
            <img src="{{ section.settings.good_image | image_url: width: 800 }}" alt="{{ section.settings.good_title | escape }}" loading="lazy" width="800" height="500">
          </div>
        {%- endif -%}
        <div class="bt-split__inner">
          {%- if section.settings.good_kicker != blank -%}
            <div class="bt-split__kicker">{{ section.settings.good_kicker }}</div>
          {%- endif -%}
          <h3 class="bt-h3">{{ section.settings.good_title }}</h3>
          <div class="bt-split__tags">
            {%- assign good_tags = section.settings.good_tags | split: '|' -%}
            {%- for tag in good_tags -%}
              <span class="bt-split__tag">{{ tag | strip }}</span>
            {%- endfor -%}
          </div>
          <p>{{ section.settings.good_text }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Batana — Coat vs heal",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most oils just coat. Real Batana absorbs." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "image_picker", "id": "bad_image", "label": "Left (them) image" },
    { "type": "text", "id": "bad_kicker", "label": "Left (them) kicker", "default": "CHEAP OILS" },
    { "type": "text", "id": "bad_title", "label": "Left (them) title", "default": "Diluted blends coat your hair" },
    { "type": "text", "id": "bad_tags", "label": "Left tags (separate with |)", "default": "Stripped|Brittle|Lifeless" },
    { "type": "textarea", "id": "bad_text", "label": "Left text", "default": "Synthetic fillers coat and weigh strands down — leaving them dull and prone to breakage." },
    { "type": "image_picker", "id": "good_image", "label": "Right (ours) image" },
    { "type": "text", "id": "good_kicker", "label": "Right (ours) kicker", "default": "HEALISTIX 100% BATANA OIL" },
    { "type": "text", "id": "good_title", "label": "Right (ours) title", "default": "Raw Batana works from within" },
    { "type": "text", "id": "good_tags", "label": "Right tags (separate with |)", "default": "Strong|Silky|Radiant" },
    { "type": "textarea", "id": "good_text", "label": "Right text", "default": "Nutrient-rich oil absorbs into the strand and scalp, nourishing at the source instead of sitting on top." }
  ],
  "presets": [{ "name": "Batana — Coat vs heal" }]
}
{% endschema %}
