{{ 'section-homepage-healistix.css' | asset_url | stylesheet_tag }}

<div class="hx-founder" style="padding: {{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px;">
  <div class="hx-founder__container">
    <div class="hx-founder__grid">
      <!-- Image Column -->
      <div class="hx-founder__image-column">
        {% if section.settings.founder_image %}
          <div class="hx-founder__image">
            {{ section.settings.founder_image | image_url: width: 600 | image_tag: alt: 'Founder' }}
          </div>
        {% endif %}
      </div>

      <!-- Content Column -->
      <div class="hx-founder__content-column">
        {% if section.settings.eyebrow %}
          <div class="hx-founder__eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}

        {% if section.settings.heading %}
          <h2 class="hx-founder__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        <div class="hx-founder__text">
          {% if section.settings.paragraph_1 %}
            <p class="hx-founder__paragraph">{{ section.settings.paragraph_1 }}</p>
          {% endif %}

          {% if section.settings.paragraph_2 %}
            <p class="hx-founder__paragraph">{{ section.settings.paragraph_2 }}</p>
          {% endif %}
        </div>

        {% if section.settings.signature %}
          <div class="hx-founder__signature">{{ section.settings.signature }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Founder Story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Founder's Vision"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "First Paragraph",
      "default": "Founded on a mission to transform skincare, Healistix was born from personal experience and scientific research."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Second Paragraph",
      "default": "Every product is crafted with intention, combining nature's most potent ingredients with modern dermatological science."
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "— The Healistix Team"
    },
    {
      "type": "image_picker",
      "id": "founder_image",
      "label": "Founder Image"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding Right",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Founder Story"
    }
  ]
}
{% endschema %}
