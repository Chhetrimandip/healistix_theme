<section class="od-section od-faq">
  <div class="od-wrap od-faq__grid">
    <aside class="od-faq__aside">
      <h2 class="od-display od-display--lg">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="od-lede">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <a class="od-btn od-btn--ghost" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </aside>

    <div class="od-faq__list" role="list">
      {%- for block in section.blocks -%}
        <details class="od-faq__item" {{ block.shopify_attributes }}>
          <summary>
            {{ block.settings.question }}
            <span class="od-faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="od-faq__answer">
            <p>{{ block.settings.answer }}</p>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OD — FAQ",
  "tag": "section",
  "class": "od-section-faq",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions people actually ask." },
    { "type": "textarea", "id": "text", "label": "Body text", "default": "If something's not answered here, email us — a real person replies within a day." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Contact us" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does a jar last?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Refrigerated and sealed, most jars last 3–4 weeks. The key lime we use as a natural preservative extends freshness without additives. If you're not going through it within a month, you can freeze portions in an ice cube tray — they drop straight into smoothies." }
      ]
    }
  ],
  "presets": [
    {
      "name": "OD — FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How long does a jar last?",
            "answer": "Refrigerated and sealed, most jars last 3–4 weeks. The key lime we use as a natural preservative extends freshness without additives. If you're not going through it within a month, you can freeze portions in an ice cube tray — they drop straight into smoothies."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is this sea moss actually wildcrafted, or is that just marketing?",
            "answer": "Wildcrafted means harvested from its natural ocean habitat, not farmed in a pool. Our sea moss grows on the volcanic rocks off the coast of St. Lucia. We've visited the harvesters. The difference in mineral density between wildcrafted and pool-grown sea moss is measurable — pool-grown absorbs whatever minerals are in the water; wildcrafted absorbs the full spectrum of the Atlantic."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I take sea moss if I'm pregnant or nursing?",
            "answer": "Sea moss is a whole food, but it's naturally high in iodine — which supports thyroid function in typical amounts, but should be monitored during pregnancy. We always recommend checking with your healthcare provider first. We're not doctors and won't pretend otherwise."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What's the difference between the plain Trinity blend and the flavored jars?",
            "answer": "The Trinity is just sea moss, bladderwrack, burdock root, alkaline water, and key lime. That's the base everything else is built on. The flavored jars add whole fruit purée — nothing artificial, no added sugar, no concentrate. The flavor profile changes, but the mineral base is the same."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How do I use it?",
            "answer": "Most people blend 1–2 tablespoons into a smoothie or stir it into oatmeal. It dissolves into liquid and doesn't have a strong taste in the plain form. The flavored blends also work well on their own as a spoonful, straight from the jar. There's no wrong way — start with a tablespoon a day and find what works for you."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do you ship outside the US?",
            "answer": "Right now we ship within the US and to Canada. International expansion is on the roadmap — sign up for our email list and you'll hear first when we open new regions."
          }
        }
      ]
    }
  ]
}
{% endschema %}
