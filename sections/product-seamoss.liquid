3.11955919 56.67966603 -123.12304688 54.04345703 C-123.12743303 51.34703039 -123.14132933 48.65092346 -123.1640625 45.95458984 C-123.19456039 42.06467991 -123.20509956 38.1751725 -123.2109375 34.28515625 C-123.2232843 33.08389099 -123.2356311 31.88262573 -123.24835205 30.6449585 C-123.22994934 23.70985502 -123.09903947 17.97379486 -118.3828125 12.49609375 C-113.95665531 9.15342296 -110.70040305 7.8115456 -105.078125 7.89453125 C-101.07970116 8.52061897 -97.79123374 10.46528539 -94.8828125 13.23828125 C-92.03757897 17.76957909 -91.37333425 21.86418287 -91.1953125 27.11328125 C-91.16115234 27.80164063 -91.12699219 28.49 -91.09179688 29.19921875 C-91.01017159 30.87836738 -90.9447968 32.55829293 -90.8828125 34.23828125 C-90.08101562 33.63242187 -89.27921875 33.0265625 -88.453125 32.40234375 C-62.93499135 13.44994453 -32.18189374 0.36033984 0 0 Z " fill="#999" transform="translate(266.8828125,7.76171875)"/>
                  <!-- Green arrow pointing left -->
                  <path d="M350 250 L320 250 L320 240 L310 250 L320 260 L320 250 Z" fill="#00ff00"/>
                </svg>
              </div>
              <div class="product-seamoss__options">
                {%- for value in option.values -%}
                  {%- liquid
                    assign flavor_emoji = ''
                    assign value_lower = value | downcase
                    if value_lower contains 'banana'
                      assign flavor_emoji = '🍌'
                    elsif value_lower contains 'blueberry'
                      assign flavor_emoji = '🫐'
                    elsif value_lower contains 'mango'
                      assign flavor_emoji = '🥭'
                    elsif value_lower contains 'strawberry'
                      assign flavor_emoji = '🍓'
                    elsif value_lower contains 'pineapple'
                      assign flavor_emoji = '🍍'
                    elsif value_lower contains 'peach'
                      assign flavor_emoji = '🍑'
                    elsif value_lower contains 'apple'
                      assign flavor_emoji = '🍎'
                    elsif value_lower contains 'orange'
                      assign flavor_emoji = '🍊'
                    elsif value_lower contains 'grape'
                      assign flavor_emoji = '🍇'
                    elsif value_lower contains 'cherry'
                      assign flavor_emoji = '🍒'
                    elsif value_lower contains 'watermelon'
                      assign flavor_emoji = '🍉'
                    elsif value_lower contains 'kiwi'
                      assign flavor_emoji = '🥝'
                    elsif value_lower contains 'coconut'
                      assign flavor_emoji = '🥥'
                    elsif value_lower contains 'lemon'
                      assign flavor_emoji = '🍋'
                    elsif value_lower contains 'lime'
                      assign flavor_emoji = '🍋'
                    else
                      assign flavor_emoji = '✨'
                    endif
                  -%}
                  <button
                    type="button"
                    class="product-seamoss__option-card{% if initial_variant.options[forloop.parentloop.index0] == value %} is-active{% endif %}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    data-option-value="{{ value | escape }}"
                  >
                    <span class="product-seamoss__option-emoji">{{ flavor_emoji }}</span>
                    <span class="product-seamoss__option-divider"></span>
                    <span class="product-seamoss__option-title">{{ value }}</span>
                    <span class="product-seamoss__option-note">{{ option.name }}</span>
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}

          {%- assign step_index = step_index | plus: 1 -%}
          <div class="product-seamoss__step">
            <div class="product-seamoss__step-label">0{{ step_index }}</div>
            <h3>{{ section.settings.quantity_heading }}</h3>
            <div class="product-seamoss__quantity-controls">
              <button type="button" data-quantity-minus aria-label="Decrease quantity">-</button>
              <input type="number" min="1" value="1" data-quantity-display aria-label="Quantity">
              <button type="button" data-quantity-plus aria-label="Increase quantity">+</button>
            </div>
          </div>

          {%- if selling_plan_group -%}
            {%- assign step_index = step_index | plus: 1 -%}
            <div class="product-seamoss__step">
              <div class="product-seamoss__step-label">0{{ step_index }}</div>
              <h3>{{ section.settings.plan_heading }}</h3>
              <p class="product-seamoss__step-note">{{ section.settings.plan_subheading }}</p>
              <div class="product-seamoss__options">
                {%- for selling_plan in selling_plan_group.selling_plans -%}
                  {%- assign adjustment = selling_plan.price_adjustments | first -%}
                  <button
                    type="button"
                    class="product-seamoss__option-card{% if selling_plan.id == initial_plan_id %} is-active{% endif %}"
                    data-plan-option="{{ selling_plan.id }}"
                  >
                    <span class="product-seamoss__option-title">{{ selling_plan.name }}</span>
                    {%- if adjustment and adjustment.value -%}
                      <span class="product-seamoss__plan-note">
                        Save {{ adjustment.value }}{% if adjustment.value_type == 'percentage' %}%{% endif %}
                      </span>
                    {%- endif -%}
                  </button>
                {%- endfor -%}
                <button
                  type="button"
                  class="product-seamoss__option-card{% if initial_plan_id == blank %} is-active{% endif %}"
                  data-plan-option=""
                >
                  <span class="product-seamoss__option-title">{{ section.settings.one_time_heading }}</span>
                  <span class="product-seamoss__option-note">{{ section.settings.one_time_subheading }}</span>
                </button>
              </div>
            </div>
          {%- endif -%}

          <div class="product-seamoss__purchase">
            <div class="product-seamoss__price-row">
              <div class="product-seamoss__price" data-product-price>{{ initial_variant.price | money }}</div>
              <div class="product-seamoss__compare" data-product-compare {% unless initial_variant.compare_at_price > initial_variant.price %}style="display:none"{% endunless %}>
                {{ initial_variant.compare_at_price | money }}
              </div>
            </div>
            <div class="product-seamoss__savings" data-product-savings>
              {%- if initial_variant.compare_at_price > initial_variant.price -%}
                {%- assign savings = initial_variant.compare_at_price | minus: initial_variant.price -%}
                {{- 'You save ' -}}
                {{ savings | money }}
              {%- endif -%}
            </div>
            <button type="button" class="product-seamoss__config-btn" data-configurator-open>
              {{ section.settings.modal_button_label }}
            </button>
            <button
              type="submit"
              class="product-seamoss__submit"
              data-product-submit
              {% unless initial_variant.available %}disabled{% endunless %}
            >
              {{ section.settings.button_label }}
            </button>
            <div data-product-errors role="alert"></div>
            {{ form | payment_terms }}
          </div>

          <div class="product-seamoss__assurances">
            {%- for block in section.blocks -%}
              {%- if block.type == 'assurance' -%}
                <div class="product-seamoss__assurance" {{ block.shopify_attributes }}>
                  <span>{{ block.settings.icon_text }}</span>
                  <p>{{ block.settings.text }}</p>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if info_tabs.size > 0 -%}
            <div class="product-info-tabs" data-product-info-tabs>
              <div class="product-info-tabs__nav">
                {%- for block in info_tabs -%}
                  <button
                    type="button"
                    class="product-info-tabs__btn{% if forloop.first %} is-active{% endif %}"
                    data-tab-target="info-{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.title }}
                  </button>
                {%- endfor -%}
              </div>
              <div class="product-info-tabs__panels">
                {%- for block in info_tabs -%}
                  <div id="info-{{ block.id }}" class="product-info-tabs__panel{% if forloop.first %} is-active{% endif %}">
                    {%- assign content = block.settings.content -%}
                    {%- assign paragraphs = content | split: '<p>' -%}
                    {%- for para in paragraphs -%}
                      {%- if para != blank and para contains '</p>' -%}
                        {%- assign clean_para = para | split: '</p>' | first -%}
                        {%- assign title_match = clean_para | split: '<strong>' | last | split: ':</strong>' | first | downcase -%}
                        {%- assign text_content = clean_para | split: '</strong>' | last -%}
                        <div class="product-info-tabs__item">
                          <div class="product-info-tabs__icon">
                            {%- if title_match contains 'energy' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="#0f7a64" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                            {%- elsif title_match contains 'gut' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="#0f7a64" stroke-width="2"><path d="M9 11a3 3 0 1 0 6 0 3 3 0 0 0-6 0z"/><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0z"/></svg>
                            {%- elsif title_match contains 'immune' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="#0f7a64" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 8v4M12 16h.01"/></svg>
                            {%- elsif title_match contains 'metabolism' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="#0f7a64" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                            {%- elsif title_match contains 'skin' or title_match contains 'hair' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="#0f7a64" stroke-width="2"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M12 6v6l4 2"/></svg>
                            {%- elsif title_match contains 'daily' or title_match contains 'dosage' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="#0f7a64" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                            {%- elsif title_match contains 'when' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="#0f7a64" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                            {%- elsif title_match contains 'monthly' or title_match contains 'supply' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="#0f7a64" stroke-width="2"><path d="M20 7h-4V6a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v1H4a1 1 0 0 0-1 1v11a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a1 1 0 0 0-1-1z"/></svg>
                            {%- elsif title_match contains 'ways' or title_match contains 'enjoy' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="#0f7a64" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                            {%- elsif title_match contains 'storage' -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="#0f7a64" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M3 9h18M9 3v18"/></svg>
                            {%- else -%}
                              <svg viewBox="0 0 24 24" fill="none" stroke="#0f7a64" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                            {%- endif -%}
                          </div>
                          <div class="product-info-tabs__item-content">{{ clean_para }}</div>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-variants>
    {{ product.variants | json }}
  </script>

  {%- if bundle_blocks.size > 0 or flavor_blocks.size > 0 -%}
    <div class="product-configurator" data-configurator hidden>
      <div class="product-configurator__overlay" data-configurator-close></div>
      <div class="product-configurator__panel">
        <button type="button" class="product-configurator__close" data-configurator-close aria-label="Close planner">
          &times;
        </button>
        <div class="product-configurator__content">
          <div class="product-configurator__step">
            <h3>{{ section.settings.bundle_heading }}</h3>
            <p>{{ section.settings.bundle_subheading }}</p>
            <div class="configurator-bundles">
              {%- for block in section.blocks -%}
                {%- if block.type == 'bundle' -%}
                  <button
                    type="button"
                    class="configurator-bundle{% if forloop.first %} is-active{% endif %}"
                    data-bundle-qty="{{ block.settings.quantity | default: 1 }}"
                    data-configurator-select="bundle"
                  >
                    <div class="configurator-bundle__top">
                      <div>
                        <div class="configurator-bundle__title">{{ block.settings.label }}</div>
                        <div class="configurator-bundle__subtitle">{{ block.settings.subtext }}</div>
                      </div>
                      <span class="configurator-bundle__price">{{ block.settings.price_text }}</span>
                    </div>
                    <div class="configurator-bundle__meta">
                      <span>{{ block.settings.tagline }}</span>
                      {%- if block.settings.badge != blank -%}
                        <span class="configurator-bundle__badge">{{ block.settings.badge }}</span>
                      {%- endif -%}
                    </div>
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
          <div class="product-configurator__step">
            <h3>{{ section.settings.flavor_heading }}</h3>
            <p>{{ section.settings.flavor_subheading }}</p>
            <div class="configurator-flavors">
              {%- for block in section.blocks -%}
                {%- if block.type == 'flavor' -%}
                  <button
                    type="button"
                    class="configurator-flavor{% if forloop.first %} is-active{% endif %}"
                    data-configurator-flavor="{{ block.settings.option_value | escape }}"
                  >
                    <span class="configurator-flavor__label">{{ block.settings.label }}</span>
                    <span class="configurator-flavor__note">{{ block.settings.tagline }}</span>
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
        <div class="product-configurator__footer">
          <button type="button" class="product-configurator__btn" data-configurator-close>{{ section.settings.modal_button_label }}</button>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.getElementById('ProductSeamoss-{{ section.id }}');
    if (!section) return;

    const variantDataEl = section.querySelector('[data-product-variants]');
    const variants = variantDataEl ? JSON.parse(variantDataEl.textContent) : [];
    const optionCount = parseInt(section.dataset.optionCount || '0', 10);
    let selectedOptions = (section.dataset.selectedOptions || '').split('||');
    if (!selectedOptions || selectedOptions.length !== optionCount) {
      selectedOptions = new Array(optionCount).fill('');
    }

    const variantInput = section.querySelector('[data-product-variant-input]');
    const priceEl = section.querySelector('[data-product-price]');
    const compareEl = section.querySelector('[data-product-compare]');
    const savingsEl = section.querySelector('[data-product-savings]');
    const submitBtn = section.querySelector('[data-product-submit]');
    const qtyInput = section.querySelector('[data-quantity-input]');
    const qtyDisplay = section.querySelector('[data-quantity-display]');
    const qtyMinus = section.querySelector('[data-quantity-minus]');
    const qtyPlus = section.querySelector('[data-quantity-plus]');
    const planButtons = section.querySelectorAll('[data-plan-option]');
    const planInput = section.querySelector('[data-selling-plan-input]');
    const optionButtons = section.querySelectorAll('[data-option-value]');
    const mainImage = section.querySelector('[data-product-media-main]');
    const thumbButtons = section.querySelectorAll('[data-product-thumb]');
    const moneyFormat = {{ shop.money_format | json }};

    const formatMoney = (value) => {
      if (window.Shopify && Shopify.formatMoney) {
        return Shopify.formatMoney(value, moneyFormat);
      }

      return (value / 100).toLocaleString(undefined, {
        style: 'currency',
        currency: '{{ shop.currency }}'
      });
    };

    const updateSavings = (variant) => {
      if (!savingsEl) return;
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        const diff = variant.compare_at_price - variant.price;
        savingsEl.textContent = `You save ${formatMoney(diff)}`;
      } else {
        savingsEl.textContent = '';
      }
    };

    const setActiveClass = (selector, value, attr = 'optionValue') => {
      section.querySelectorAll(selector).forEach((el) => {
        if (value && el.dataset[attr] === value) {
          el.classList.add('is-active');
        } else if (!value && !el.dataset[attr]) {
          el.classList.add('is-active');
        } else {
          el.classList.remove('is-active');
        }
      });
    };

    const updateVariant = () => {
      if (!variants.length) return;
      const variant = variants.find((entry) => {
        return entry.options.every((option, index) => {
          if (!selectedOptions[index]) return true;
          return option === selectedOptions[index];
        });
      });

      if (!variant) {
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = '{{ 'products.product.sold_out' | t | escape }}';
        }
        return;
      }

      if (variantInput) {
        variantInput.value = variant.id;
      }

      if (priceEl) {
        priceEl.textContent = formatMoney(variant.price);
      }

      if (compareEl) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          compareEl.textContent = formatMoney(variant.compare_at_price);
          compareEl.style.display = 'inline-flex';
        } else {
          compareEl.style.display = 'none';
        }
      }

      updateSavings(variant);

      if (submitBtn) {
        submitBtn.disabled = !variant.available;
        submitBtn.textContent = variant.available ? {{ section.settings.button_label | json }} : '{{ 'products.product.sold_out' | t | escape }}';
      }

      if (variant.featured_media && mainImage) {
        const newSrc = `${variant.featured_media.preview_image.src}&width=900`;
        mainImage.src = newSrc;
        mainImage.alt = variant.featured_media.preview_image.alt || mainImage.alt;
      }
    };

    optionButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const optionIndex = parseInt(button.dataset.optionIndex, 10);
        const optionValue = button.dataset.optionValue;
        selectedOptions[optionIndex] = optionValue;
        section.setAttribute('data-selected-options', selectedOptions.join('||'));
        setActiveClass(`[data-option-index="${optionIndex}"]`, optionValue);
        updateVariant();
      });
    });

    planButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const planId = button.dataset.planOption || '';
        planInput.value = planId;
        planButtons.forEach((planButton) => planButton.classList.remove('is-active'));
        button.classList.add('is-active');
      });
    });

    const updateQuantity = (value) => {
      const parsed = Math.max(1, parseInt(value || '1', 10));
      if (qtyDisplay) qtyDisplay.value = parsed;
      if (qtyInput) qtyInput.value = parsed;
    };

    if (qtyMinus) {
      qtyMinus.addEventListener('click', () => {
        updateQuantity((parseInt(qtyDisplay.value, 10) || 1) - 1);
      });
    }

    if (qtyPlus) {
      qtyPlus.addEventListener('click', () => {
        updateQuantity((parseInt(qtyDisplay.value, 10) || 1) + 1);
      });
    }

    if (qtyDisplay) {
      qtyDisplay.addEventListener('change', () => updateQuantity(qtyDisplay.value));
    }

    thumbButtons.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const image = thumb.dataset.image;
        if (image && mainImage) {
          mainImage.src = image;
        }
        thumbButtons.forEach((btn) => btn.classList.remove('is-active'));
        thumb.classList.add('is-active');
      });
    });

    const infoTabsContainer = section.querySelector('[data-product-info-tabs]');
    if (infoTabsContainer) {
      const tabButtons = infoTabsContainer.querySelectorAll('[data-tab-target]');
      const tabPanels = infoTabsContainer.querySelectorAll('.product-info-tabs__panel');
      tabButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const id = button.dataset.tabTarget;
          tabButtons.forEach((btn) => btn.classList.remove('is-active'));
          tabPanels.forEach((panel) => panel.classList.remove('is-active'));
          button.classList.add('is-active');
          infoTabsContainer.querySelector('#' + id)?.classList.add('is-active');
        });
      });
    }

    const configurator = section.querySelector('[data-configurator]');
    const configuratorOpen = section.querySelector('[data-configurator-open]');
    const configuratorCloseElements = section.querySelectorAll('[data-configurator-close]');

    const setConfiguratorState = (open) => {
      if (!configurator) return;
      configurator.hidden = !open;
      configurator.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('configurator-open', open);
    };

    if (configurator && configuratorOpen) {
      configuratorOpen.addEventListener('click', () => setConfiguratorState(true));
      configuratorCloseElements.forEach((element) => {
        element.addEventListener('click', () => setConfiguratorState(false));
      });

      const bundleButtons = configurator.querySelectorAll('[data-bundle-qty]');
      bundleButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const qty = parseInt(button.dataset.bundleQty || '1', 10);
          updateQuantity(qty);
          bundleButtons.forEach((btn) => btn.classList.remove('is-active'));
          button.classList.add('is-active');
        });
      });

      const flavorButtons = configurator.querySelectorAll('[data-configurator-flavor]');
      flavorButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const flavorValue = button.dataset.configuratorFlavor;
          optionButtons.forEach((optionButton) => {
            if (optionButton.dataset.optionValue === flavorValue) {
              optionButton.click();
            }
          });
          flavorButtons.forEach((btn) => btn.classList.remove('is-active'));
          button.classList.add('is-active');
        });
      });
    }

    // Force horizontal scroll layout on mobile
    const optionsContainers = section.querySelectorAll('.product-seamoss__options');
    optionsContainers.forEach((container) => {
      container.style.display = 'flex';
      container.style.flexDirection = 'row';
      container.style.gridTemplateColumns = 'none';
      container.style.overflowX = 'auto';
      container.style.webkitOverflowScrolling = 'touch';
    });

    updateVariant();
  });
</script>

