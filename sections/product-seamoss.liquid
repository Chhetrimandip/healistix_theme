{{ 'section-product-seamoss.css' | asset_url | stylesheet_tag }}
{{ 'hx-pdp-playful.css' | asset_url | stylesheet_tag }}
{{ 'hx-bloom-pdp.css' | asset_url | stylesheet_tag }}
{{ 'hx-product-collage.css' | asset_url | stylesheet_tag }}
{{ 'hx-clean-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hx-product-collage.js' | asset_url }}" defer></script>
<script src="{{ 'hx-clean-pdp.js' | asset_url }}" defer></script>
<script src="{{ 'hx-mix-flavors.js' | asset_url }}" defer></script>
<script src="{{ 'hx-gift-preview.js' | asset_url }}" defer></script>
<script src="{{ 'hx-jar-viewer.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign initial_variant = product.selected_or_first_available_variant
  capture supported_flavors
    render 'hx-flavor-support'
  endcapture
  assign pilot_flavors = supported_flavors | strip | split: ','
  capture interactive_flavors
    render 'hx-flavor-support', mode: 'interactive'
  endcapture
  assign jar_flavors = interactive_flavors | strip | split: ','
  assign option_count = product.options_with_values | size
  assign selected_options_string = initial_variant.options | join: '||'
  assign flavor_blocks = section.blocks | where: 'type', 'flavor'
  assign promo_blocks = section.blocks | where: 'type', 'promo'
  assign info_tabs = section.blocks | where: 'type', 'info_tab'
  assign assurance_blocks = section.blocks | where: 'type', 'assurance'
  assign logo_blocks = section.blocks | where: 'type', 'logo'
-%}

<section
  id="ProductSeamoss-{{ section.id }}"
  class="product-seamoss product-seamoss--gruns hx-bloom-pdp hx-clean-pdp hx-bold-pdp"
  data-section-id="{{ section.id }}"
  data-option-count="{{ option_count }}"
  data-selected-options="{{ selected_options_string | escape }}"
  data-active-flavor="{{ initial_variant.option1 | downcase | escape }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-cart-root="{{ routes.root_url }}"
>
  <div class="hx-flavor-accents" aria-hidden="true" hidden>
    <img alt="" width="200" height="200" decoding="async">
    <img alt="" width="200" height="200" decoding="async">
    <img alt="" width="200" height="200" decoding="async">
  </div>
  <script type="application/json" data-fruit-assets>{"banana":{{ 'fruit-banana.png' | asset_url | json }},"blueberry":{{ 'fruit-blueberry.png' | asset_url | json }},"mango":{{ 'fruit-mango.png' | asset_url | json }},"grape":{{ 'fruit-grape.png' | asset_url | json }},"red guava":{{ 'fruit-guava.png' | asset_url | json }},"guava lemon":{{ 'fruit-guava.png' | asset_url | json }},"elderberry ginger":{{ 'fruit-elderberry.png' | asset_url | json }},"ashwagandha mango":{{ 'fruit-mango.png' | asset_url | json }},"pineapple mango":{{ 'fruit-mango.png' | asset_url | json }}}</script>
  <div class="product-seamoss__container page-width">
    <div class="product-seamoss__layout">
      <div class="product-seamoss__media">
        {%- comment -%} Thumbs first in DOM — CSS flex order puts them left on desktop, below on mobile {%- endcomment -%}
        {%- if product.images.size > 0 -%}
          <div class="product-seamoss__media-thumbs">
            {% render 'hx-pilot-gallery', product: product, initial_variant: initial_variant %}
            {%- for image in product.images -%}
              {%- liquid
                assign flavor_keys = ''
                if image.attached_to_variant?
                  for attached_variant in image.variants
                    assign flavor_keys = flavor_keys | append: attached_variant.option1 | append: '|'
                  endfor
                endif
                assign haystack = image.src | append: ' ' | append: image.alt | downcase
                for option in product.options_with_values
                  for value in option.values
                    assign value_down = value | downcase
                    if haystack contains value_down
                      assign flavor_keys = flavor_keys | append: value | append: '|'
                    endif
                  endfor
                endfor
                if flavor_keys == blank
                  assign flavor_keys = '*'
                endif
                assign replaced_by_cutout = false
                for pilot_flavor in pilot_flavors
                  if flavor_keys contains pilot_flavor
                    if haystack contains 'hx-pilot-'
                      assign replaced_by_cutout = true
                    endif
                  endif
                endfor
                if haystack contains 'sea_moss_gel_-_banana_16_oz' or haystack contains 'seamossgoldgelbananaprime'
                  assign replaced_by_cutout = true
                endif
                if replaced_by_cutout
                  continue
                endif
                assign show_thumb = false
                if flavor_keys == '*' or flavor_keys contains initial_variant.option1
                  assign show_thumb = true
                endif
              -%}
              <button
                type="button"
                class="product-seamoss__media-thumb{% if show_thumb and initial_variant.featured_image and image.id == initial_variant.featured_image.id %} is-active{% endif %}"
                data-product-thumb
                data-media-id="{{ image.id }}"
                data-image="{{ image | image_url: width: 900 }}"
                data-flavors="{{ flavor_keys | escape }}"
                aria-label="View {{ image.alt | default: product.title | escape }}"
                {% unless show_thumb %}hidden{% endunless %}
              >
                <img src="{{ image | image_url: width: 300 }}" alt="{{ image.alt | escape }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="product-seamoss__media-main">
          <div class="hx-gallery-heading"><span>A LITTLE DAILY GOODNESS</span><span class="hx-flavor-pill" data-gallery-flavor>{{ initial_variant.option1 }}</span></div>
          <span class="hx-gallery-spark hx-gallery-spark--one" aria-hidden="true">✦</span>
          <span class="hx-gallery-spark hx-gallery-spark--two" aria-hidden="true">✦</span>
          {%- assign gallery_media = initial_variant.featured_media -%}
          {%- assign campaign_flavors = 'Banana,Blueberry,Mango,Pineapple,Watermelon' | split: ',' -%}
          {%- if campaign_flavors contains initial_variant.option1 -%}
            {%- assign story_hero = initial_variant.option1 | handleize | prepend: 'hx-' | append: '-hero-v9.png' -%}
            {% if initial_variant.option1 == 'Blueberry' %}{% assign story_hero = 'hx-blueberry-studio-v3.png' %}{% endif %}
            <img src="{{ story_hero | asset_url }}" alt="Healistix {{ initial_variant.option1 | escape }} sea moss gel with fresh fruit" loading="eager" width="1254" height="1254" data-product-media-main>
          {%- elsif pilot_flavors contains initial_variant.option1 -%}
            {%- assign pilot_hero = initial_variant.option1 | handleize | prepend: 'hx-pilot-' | append: '-front.webp' -%}
            <img src="{{ pilot_hero | asset_url }}" alt="{{ initial_variant.option1 | escape }} sea moss gel — front" loading="eager" width="1354" height="1836" data-product-media-main>
          {%- elsif gallery_media -%}
            {%- assign featured_image = gallery_media | image_url: width: 900 -%}
            <img
              src="{{ featured_image }}"
              alt="{{ gallery_media.alt | escape }}"
              loading="eager"
              width="{{ gallery_media.width }}"
              height="{{ gallery_media.height }}"
              data-product-media-main
            >
          {%- else -%}
            <img
              alt="{{ product.title | escape }}"
              loading="lazy"
              width="900"
              height="900"
              data-product-media-main
              hidden
            >
          {%- endif -%}
          <p class="hx-gallery-empty" data-gallery-empty{% if gallery_media or pilot_flavors contains initial_variant.option1 %} hidden{% endif %}>Photos for {{ initial_variant.option1 | escape }} are coming soon.</p>
          {%- if section.settings.enable_jar_viewer -%}
            {% render 'hx-jar-viewer' %}
          {%- endif -%}
          <button class="hx-gallery-open" type="button" data-gallery-open aria-label="Enlarge product image"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg>Take a closer look</span></button>
          <div class="hx-gallery-caption"><span class="hx-caption-photo">Meet your next spoonful.</span><span class="hx-caption-spin">Drag it. Turn it. Get to know it.</span><span aria-hidden="true">✳</span></div>
        </div>

        {%- if promo_blocks.size > 0 -%}
          <div class="product-seamoss__promo-grid">
            {%- for block in promo_blocks -%}
              <div class="product-seamoss__promo-card" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 320 }}" alt="{{ block.settings.title | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
                {%- endif -%}
                <div class="product-seamoss__promo-copy">
                  {%- if block.settings.eyebrow != blank -%}
                    <p class="product-seamoss__promo-eyebrow">{{ block.settings.eyebrow }}</p>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <p class="product-seamoss__promo-title">{{ block.settings.title }}</p>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="product-seamoss__promo-text">{{ block.settings.text }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="hx-gallery-tools">
          {% if section.settings.enable_jar_viewer %}
            <button type="button" data-jar-trigger aria-label="Explore {{ initial_variant.option1 | escape }} in 360 degrees" aria-pressed="false"{% unless jar_flavors contains initial_variant.option1 %} hidden{% endunless %}>↻ Explore in 360°</button>
            <button type="button" class="hx-gallery-return" data-gallery-return>Back to photos</button>
          {% endif %}
        <button
          class="product-seamoss__nutrition-btn"
          type="button"
          data-hx-nutrition-toggle
          aria-controls="HxNutriDrawer-{{ section.id }}"
          aria-expanded="false"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
          View Jar Label
        </button>
        </div>
      </div>

      <div class="product-seamoss__details">
        <div class="hx-buybox">
        <div class="hx-product-intro">
        <p class="hx-brand-kicker">HEALISTIX · ISLAND ROOTS, EVERYDAY RITUAL</p>
        <div class="hx-card-badges">
        <a class="hx-review-proof" href="#customer-voices">
          {% if product.metafields.judgeme.badge != blank %}
            <template data-review-badge>{{ product.metafields.judgeme.badge }}</template><span data-review-summary>Read customer reviews ↗</span>
          {% else %}
            “The taste is not strong at all” <em>— Liliane, Raw Original review ↗</em>
          {% endif %}
        </a>
        <span class="hx-origin-badge">St. Lucia sourced</span>
        </div>
        {%- if section.settings.eyebrow_text != blank -%}
          <p class="product-seamoss__eyebrow">{{ section.settings.eyebrow_text }}</p>
        {%- endif -%}

        <h1 class="product-seamoss__title">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading }}
          {%- else -%}
            {{ product.title }}
          {%- endif -%}
        </h1>
        <p class="hx-taste-intro"><span class="hx-taste-intro__mark" aria-hidden="true">✦</span>THE BEST-TASTING SEA MOSS.</p>
        <p class="hx-banana-top-proof">Vitamin B6 for immune support · Iron for oxygen transport <a href="#hx-banana-benefits">See serving facts ↗</a></p>
        <ul class="hx-top-benefits" aria-label="Product highlights">
          <li><span aria-hidden="true">✦</span> St. Lucia sea moss</li>
          <li><span aria-hidden="true">♡</span> Find your favorite flavor</li>
          <li><span aria-hidden="true">✓</span> No soaking. No prep.</li>
        </ul>
        </div>
        {%- if logo_blocks.size > 0 -%}
          <div class="product-seamoss__logos">
            {%- for block in logo_blocks -%}
              {%- if block.settings.image != blank -%}
                <div class="product-seamoss__logo" {{ block.shopify_attributes }}>
                  <img src="{{ block.settings.image | image_url: width: 160 }}" alt="{{ block.settings.alt_text | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {% render 'hx-custom-blend-entry' %}
        {%- assign form_id = 'ProductSeamossForm-' | append: section.id -%}
        {%- form 'product', product, id: form_id, class: 'product-seamoss__form', novalidate: 'novalidate', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ initial_variant.id }}" data-product-variant-input>
          <input type="hidden" name="quantity" value="1" data-quantity-input>


          {%- for option in product.options_with_values -%}
            <div class="product-seamoss__flavor-block" data-option-block>
              <h3 class="product-seamoss__flavor-heading">
                <span class="product-seamoss__flavor-heading-static">
                  {%- if section.settings.flavor_heading != blank -%}
                    {{ section.settings.flavor_heading }}
                  {%- else -%}
                    Select {{ option.name }}
                  {%- endif -%}:
                </span>
                <span class="product-seamoss__flavor-heading-value" data-flavor-current-name>{{ initial_variant.options[forloop.index0] }}</span>
              </h3>
              {%- if section.settings.flavor_subheading != blank -%}
                <p class="product-seamoss__flavor-subheading">{{ section.settings.flavor_subheading }}</p>
              {%- endif -%}

              <div class="product-seamoss__flavor-grid" role="listbox" aria-label="{{ option.name | escape }}">
                {%- assign display_values = option.values -%}
                {%- if option.name == 'Flavor' -%}
                  {%- assign display_values = pilot_flavors | concat: option.values | uniq -%}
                {%- endif -%}
                {%- for value in display_values -%}
                  {%- unless option.values contains value -%}{%- continue -%}{%- endunless -%}
                  {%- if value == 'Rose' or value == 'Orange' -%}{%- continue -%}{%- endif -%}
                  {%- liquid
                    assign flavor_label = value
                    assign flavor_tagline = ''
                    assign flavor_badge = ''
                    assign flavor_image = blank

                    for block in flavor_blocks
                      if block.settings.option_value == value
                        if block.settings.label != blank
                          assign flavor_label = block.settings.label
                        endif
                        assign flavor_tagline = block.settings.tagline
                        assign flavor_badge = block.settings.badge
                        assign flavor_image = block.settings.image
                        break
                      endif
                    endfor

                    if flavor_tagline == blank or flavor_badge == blank
                      for v in product.variants
                        if v.options contains value
                          if flavor_tagline == blank and v.metafields.seamoss.flavor_tagline != blank
                            assign flavor_tagline = v.metafields.seamoss.flavor_tagline.value
                          endif
                          if flavor_badge == blank and v.metafields.seamoss.flavor_badge != blank
                            assign flavor_badge = v.metafields.seamoss.flavor_badge.value
                          endif
                          if flavor_tagline == blank and v.metafields.seamoss.tastes_like != blank
                            assign flavor_tagline = v.metafields.seamoss.tastes_like.value
                          endif
                          break
                        endif
                      endfor
                    endif

                    assign fruit_asset = value | downcase | replace: ' ', '-' | prepend: 'fruit-' | append: '.png' | asset_url
                    assign flavor_variant = nil
                    for v in product.variants
                      if v.options contains value
                        assign flavor_variant = v
                        break
                      endif
                    endfor
                    assign is_active = false
                    if initial_variant.options[forloop.parentloop.index0] == value
                      assign is_active = true
                    endif
                  -%}

                  <button
                    type="button"
                    class="product-seamoss__flavor-card{% if is_active %} is-active{% endif %}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    data-option-value="{{ value | escape }}"
                    role="option"
                    aria-selected="{% if is_active %}true{% else %}false{% endif %}"
                  >
                    {%- if flavor_badge != blank -%}
                      <span class="product-seamoss__flavor-badge">{{ flavor_badge }}</span>
                    {%- endif -%}
                    <span class="product-seamoss__flavor-thumb">
                      {%- if flavor_image != blank -%}
                        <img src="{{ flavor_image | image_url: width: 200 }}" alt="{{ flavor_label | escape }}" width="100" height="100" loading="lazy">
                      {%- elsif pilot_flavors contains value -%}
                        {%- assign pilot_picker = value | handleize | prepend: 'hx-pilot-' | append: '-front.webp' -%}
                        <img src="{{ pilot_picker | asset_url }}" alt="{{ flavor_label | escape }}" width="100" height="100" loading="lazy">
                      {%- elsif flavor_variant.featured_image -%}
                        <img src="{{ flavor_variant.featured_image | image_url: width: 200 }}" alt="{{ flavor_label | escape }}" width="100" height="100" loading="lazy">
                      {%- elsif value == 'Apple' or value == 'Guava' or value == 'Grape' or value == 'Elderberry' -%}
                        <img src="{{ fruit_asset }}" alt="{{ flavor_label | escape }}" width="100" height="100" loading="lazy">
                      {%- else -%}
                        <span class="hx-flavor-fallback" aria-hidden="true">{{ flavor_label | slice: 0 }}</span>
                      {%- endif -%}
                    </span>
                    <span class="product-seamoss__flavor-label">{{ flavor_label }}</span>
                    <span class="hx-flavor-benefit">{% render 'hx-flavor-benefit', flavor: value %}</span>
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}

          {% render 'hx-subscription-options', product: product, section: section %}
          <div class="product-seamoss__purchase">
            <p class="hx-purchase-label">One-time purchase<small>Your selected jar, delivered once.</small></p>
            <div class="product-seamoss__price-row">
              <div class="product-seamoss__price" data-product-price>{{ initial_variant.price | money }}</div>
              <div
                class="product-seamoss__compare"
                data-product-compare
                {% unless initial_variant.compare_at_price > initial_variant.price %}style="display:none"{% endunless %}
              >
                {{ initial_variant.compare_at_price | money }}
              </div>
            </div>
            <div class="product-seamoss__savings" data-product-savings>
              {%- if initial_variant.compare_at_price > initial_variant.price -%}
                {%- assign savings = initial_variant.compare_at_price | minus: initial_variant.price -%}
                {{- 'You save ' -}}
                {{ savings | money }}
              {%- endif -%}
            </div>

            <div class="product-seamoss__qty-row">
              <label class="product-seamoss__qty-label" for="ProductSeamossQty-{{ section.id }}">
                {{ section.settings.quantity_heading | default: 'Quantity' }}
              </label>
              <div class="product-seamoss__quantity-controls">
                <button type="button" data-quantity-minus aria-label="Decrease quantity">−</button>
                <input
                  id="ProductSeamossQty-{{ section.id }}"
                  type="number"
                  min="1"
                  value="1"
                  data-quantity-display
                  aria-label="Quantity"
                >
                <button type="button" data-quantity-plus aria-label="Increase quantity">+</button>
              </div>
            </div>

            <button
              type="submit"
              class="product-seamoss__submit"
              data-product-submit
              {% unless initial_variant.available %}disabled{% endunless %}
            >
              {{ section.settings.button_label }}
            </button>

            {%- if section.settings.trust_line != blank -%}
              <p class="product-seamoss__trust">{{ section.settings.trust_line }}</p>
            {%- endif -%}
            {%- if section.settings.guarantee_note != blank -%}
              <p class="product-seamoss__guarantee">{{ section.settings.guarantee_note }}</p>
            {%- endif -%}

            <div data-product-errors role="alert"></div>
            {{ form | payment_terms }}
          </div>

          <section class="hx-after-purchase-benefits" aria-label="Product benefits"><h2>Goodness in your daily spoonful.</h2><div class="hx-routine-details">
        {%- if section.settings.review_subtext != blank -%}
          <p class="product-seamoss__subtext">{{ section.settings.review_subtext }}</p>
        {%- endif -%}

        {%- if section.settings.support_points != blank -%}
          <ul class="product-seamoss__benefits">
            {%- assign points = section.settings.support_points | split: '|' -%}
            {%- for point in points -%}
              {%- if point != blank -%}
                <li class="product-seamoss__benefit">
                  <span class="product-seamoss__benefit-check" aria-hidden="true">✓</span>
                  <span>{{ point | strip }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="hx-nutrient-summary">
          <p class="hx-benefit-kicker">BANANA · BENEFITS IN YOUR SPOONFUL</p>
          <ul class="hx-benefit-preview" aria-label="Banana nutrient functions">
            <li><strong>Immune support</strong><span>Vitamin B6 supports normal immune function.</span></li>
            <li><strong>Nutrient metabolism</strong><span>Vitamin B6 helps your body metabolize nutrients.</span></li>
            <li><strong>Oxygen transport</strong><span>Iron helps make oxygen-carrying hemoglobin.</span></li>
            <li><strong>Cell renewal</strong><span>Folate supports normal cell division.</span></li>
          </ul>
          <a href="#hx-banana-benefits">See serving amounts &amp; the science ↗</a>
        </div>
          </div></section>

          {% render 'hx-gift-preview' %}
          {%- if assurance_blocks.size > 0 -%}
            <div class="product-seamoss__assurances">
              {%- for block in assurance_blocks -%}
                <div class="product-seamoss__assurance" {{ block.shopify_attributes }}>
                  <span aria-hidden="true">{{ block.settings.icon_text }}</span>
                  <p>{{ block.settings.text }}</p>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if info_tabs.size > 0 -%}
            <div class="product-seamoss__accordions" data-product-accordions>
              {%- for block in info_tabs -%}
                <details
                  class="product-seamoss__accordion"

                  {{ block.shopify_attributes }}
                >
                  <summary class="product-seamoss__accordion-summary">
                    <span>{{ block.settings.title }}</span>
                    <span class="product-seamoss__accordion-icon" aria-hidden="true"></span>
                  </summary>
                  <div class="product-seamoss__accordion-body rte">
                    {{ block.settings.content }}
                  </div>
                </details>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endform -%}
        </div>
        {% render 'hx-pair-with', product: product, section: section %}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-variants>
    {{ product.variants | json }}
  </script>

  {%- comment -%}── Nutrition Label Drawer ──────────────────────────────{%- endcomment -%}
  <dialog
    class="hx-nutri-drawer"
    id="HxNutriDrawer-{{ section.id }}"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="Healistix jar label and ingredients"
  >
    <div class="hx-nutri-drawer__overlay" data-hx-nutrition-close></div>
    <div class="hx-nutri-drawer__panel">

      <div class="hx-nutri-drawer__header">
        <h2 class="hx-nutri-drawer__title">Jar label &amp; ingredients</h2>
        <button class="hx-nutri-drawer__close" data-hx-nutrition-close aria-label="Close jar label">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <div class="hx-nutri-drawer__body">
        {% render 'hx-flavor-labels', initial_variant: initial_variant %}
      </div>{%- comment -%}end body{%- endcomment -%}
    </div>{%- comment -%}end panel{%- endcomment -%}
  </dialog>{%- comment -%}end drawer{%- endcomment -%}

