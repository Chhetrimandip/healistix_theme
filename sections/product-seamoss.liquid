<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.getElementById('ProductSeamoss-{{ section.id }}');
    if (!section) return;

    const variantDataEl = section.querySelector('[data-product-variants]');
    const variants = variantDataEl ? JSON.parse(variantDataEl.textContent) : [];
    const optionCount = parseInt(section.dataset.optionCount || '0', 10);
    let selectedOptions = (section.dataset.selectedOptions || '').split('||');
    if (!selectedOptions || selectedOptions.length !== optionCount) {
      selectedOptions = new Array(optionCount).fill('');
    }

    const variantInput = section.querySelector('[data-product-variant-input]');
    const priceEl = section.querySelector('[data-product-price]');
    const compareEl = section.querySelector('[data-product-compare]');
    const savingsEl = section.querySelector('[data-product-savings]');
    const submitBtn = section.querySelector('[data-product-submit]');
    const qtyInput = section.querySelector('[data-quantity-input]');
    const qtyDisplay = section.querySelector('[data-quantity-display]');
    const qtyMinus = section.querySelector('[data-quantity-minus]');
    const qtyPlus = section.querySelector('[data-quantity-plus]');
    const optionButtons = section.querySelectorAll('[data-option-value]');
    const mainImage = section.querySelector('[data-product-media-main]');
    const thumbButtons = section.querySelectorAll('[data-product-thumb]');
    const moneyFormat = {{ shop.money_format | json }};
    const buttonLabel = {{ section.settings.button_label | json }};
    const soldOutLabel = {{ 'products.product.sold_out' | t | json }};

    const formatMoney = (value) => {
      if (window.Shopify && Shopify.formatMoney) {
        return Shopify.formatMoney(value, moneyFormat);
      }
      return (value / 100).toLocaleString(undefined, {
        style: 'currency',
        currency: '{{ shop.currency }}'
      });
    };

    const planSelect = section.querySelector('[data-hx-plan]');
    const planNote = section.querySelector('[data-hx-plan-note]');
    const subscriptionData = JSON.parse(section.querySelector('[data-hx-subscription-data]').textContent);
    const purchaseFor = (variant) => {
      const data = subscriptionData.variants[String(variant.id)];
      const plan = planSelect?.value || '';
      const allocation = data?.plans.find(entry => entry.id === plan);
      return {
        valid: plan ? Boolean(allocation) : !data?.required,
        price: plan ? allocation?.price : variant.price,
        plan
      };
    };
    section.hxPurchase = purchaseFor;
    const renderOffer = (items) => {
      const offer = section.querySelector('[data-hx-offer]');
      if (!offer || !planSelect) return;
      const planId = planSelect.value || [...planSelect.options].find(option => option.value)?.value;
      let regular = 0, subscription = 0;
      const eligible = items.length && items.every(({variant, quantity}) => {
        const allocation = subscriptionData.variants[String(variant.id)]?.plans.find(plan => plan.id === planId);
        if (!allocation) return false;
        regular += variant.price * quantity;
        subscription += allocation.price * quantity;
        return true;
      });
      offer.hidden = !eligible;
      const savings = regular - subscription;
      section.querySelector('[data-hx-offer-title]').textContent = eligible && savings > 0
        ? `Subscribe & save ${Math.round(savings / regular * 100)}%` : 'Subscribe for regular deliveries';
      if (!eligible) return;
      const planName = [...planSelect.options].find(option => option.value === planId)?.textContent || '';
      section.querySelector('[data-hx-offer-price]').textContent = `${formatMoney(subscription)} per delivery`;
      section.querySelector('[data-hx-offer-saving]').textContent = savings > 0
        ? `Save ${formatMoney(savings)} compared with ${formatMoney(regular)} one-time · ${planName}`
        : planName;
    };
    section.hxRenderOffer = renderOffer;
    const updatePurchase = () => {
      const variant = variants.find(entry => String(entry.id) === variantInput.value);
      if (!variant) return;
      const purchase = purchaseFor(variant);
      const quantity = Math.max(1, parseInt(qtyDisplay?.value, 10) || 1);
      section.dataset.subscriptionSelected = String(Boolean(purchase.plan));
      if (section.dataset.purchaseMode !== 'mix') renderOffer([{variant, quantity}]);
      if (priceEl) priceEl.textContent = purchase.valid ? formatMoney(purchase.price) : 'Unavailable';
      const compare = purchase.plan ? variant.price : variant.compare_at_price;
      if (compareEl) {
        compareEl.style.display = purchase.valid && compare > purchase.price ? 'inline-flex' : 'none';
        if (compare > purchase.price) compareEl.textContent = formatMoney(compare);
      }
      if (savingsEl) savingsEl.textContent = purchase.valid && compare > purchase.price ? `You save ${formatMoney(compare - purchase.price)} per jar` : '';
      if (submitBtn) {
        submitBtn.disabled = !variant.available || !purchase.valid;
        submitBtn.textContent = !variant.available ? soldOutLabel : !purchase.valid ? 'Choose an available purchase option' : `${purchase.plan ? 'Subscribe' : buttonLabel} · ${formatMoney(purchase.price * quantity)}`;
      }
      if (planNote) planNote.textContent = purchase.plan
        ? 'Renews automatically on the selected schedule. Prices shown are for this delivery; review ongoing charges and cancellation terms at checkout.'
        : 'Your selected jars, delivered once.';
    };
    planSelect?.addEventListener('change', () => {
      updatePurchase();
      section.dispatchEvent(new CustomEvent('hx:purchase-change'));
    });
    section.querySelector('[data-product-form]').addEventListener('submit', event => {
      if (section.dataset.purchaseMode === 'mix') return;
      const variant = variants.find(entry => String(entry.id) === variantInput.value);
      if (!variant || !purchaseFor(variant).valid) {
        event.preventDefault();
        event.stopImmediatePropagation();
        section.querySelector('[data-product-errors]').textContent = 'Choose an available purchase option for this flavor.';
      }
    }, true);

    const updateSavings = (variant) => {
      if (!savingsEl) return;
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        savingsEl.textContent = `You save ${formatMoney(variant.compare_at_price - variant.price)}`;
      } else {
        savingsEl.textContent = '';
      }
    };

    const updateVariant = () => {
      if (!variants.length) return;
      const variant = variants.find((entry) =>
        entry.options.every((option, index) => {
          if (!selectedOptions[index]) return true;
          return option === selectedOptions[index];
        })
      );

      if (!variant) {
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = soldOutLabel;
        }
        return;
      }

      if (variantInput) variantInput.value = variant.id;
      section.dataset.activeFlavor = (variant.option1 || '').toLowerCase();
      section.dispatchEvent(new CustomEvent('hx:variant-change', { detail: { variant } }));
      if (priceEl) priceEl.textContent = formatMoney(variant.price);

      if (compareEl) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          compareEl.textContent = formatMoney(variant.compare_at_price);
          compareEl.style.display = 'inline-flex';
        } else {
          compareEl.style.display = 'none';
        }
      }

      updateSavings(variant);

      if (submitBtn) {
        submitBtn.disabled = !variant.available;
        submitBtn.textContent = variant.available ? `${buttonLabel} · ${formatMoney(variant.price * (parseInt(qtyDisplay?.value, 10) || 1))}` : soldOutLabel;
      }

      const flavorName = variant.option1 || selectedOptions[0] || '';
      let hasLabel = false;
      section.querySelectorAll('[data-flavor-label]').forEach(panel => {
        panel.hidden = panel.dataset.flavorLabel !== flavorName;
        if (!panel.hidden) hasLabel = true;
      });
      const nutritionToggle = section.querySelector('[data-hx-nutrition-toggle]');
      if (nutritionToggle) nutritionToggle.hidden = !hasLabel;

      const thumbs = section.querySelectorAll('[data-product-thumb]');
      let firstVisibleThumb = null;
      thumbs.forEach((thumb) => {
        const flavors = thumb.dataset.flavors || '*';
        const show = flavors === '*' || flavors.split('|').includes(flavorName);
        thumb.hidden = !show;
        thumb.classList.toggle('is-active', false);
        if (show && !firstVisibleThumb) firstVisibleThumb = thumb;
      });

      if (firstVisibleThumb?.hasAttribute('data-pilot-cutout') && mainImage) {
        mainImage.src = firstVisibleThumb.dataset.image;
        mainImage.alt = firstVisibleThumb.querySelector('img').alt;
      } else if (variant.featured_media && mainImage) {
        const src = variant.featured_media.preview_image.src;
        mainImage.src = src.includes('?') ? `${src}&width=900` : `${src}?width=900`;
        mainImage.alt = variant.featured_media.preview_image.alt || mainImage.alt;
        thumbs.forEach((thumb) => {
          if (!thumb.hidden && String(thumb.dataset.mediaId) === String(variant.featured_media.id)) {
            firstVisibleThumb = thumb;
          }
        });
      } else if (firstVisibleThumb && mainImage) {
        mainImage.src = firstVisibleThumb.dataset.image;
      }

      const hasPhoto = Boolean(firstVisibleThumb || variant.featured_media);
      if (mainImage) mainImage.hidden = !hasPhoto;
      const emptyGallery = section.querySelector('[data-gallery-empty]');
      if (emptyGallery) {
        emptyGallery.hidden = hasPhoto;
        emptyGallery.textContent = `Photos for ${flavorName} are coming soon.`;
      }

      if (firstVisibleThumb) firstVisibleThumb.classList.add('is-active');

      if (variant.id && window.history && window.history.replaceState) {
        const nextUrl = new URL(window.location.href);
        nextUrl.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', nextUrl);
      }
      updatePurchase();
      section.dispatchEvent(new CustomEvent('hx:gallery-updated'));
    };

    optionButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const optionIndex = parseInt(button.dataset.optionIndex, 10);
        const optionValue = button.dataset.optionValue;
        selectedOptions[optionIndex] = optionValue;
        section.setAttribute('data-selected-options', selectedOptions.join('||'));

        section.querySelectorAll(`[data-option-index="${optionIndex}"]`).forEach((el) => {
          const active = el.dataset.optionValue === optionValue;
          el.classList.toggle('is-active', active);
          el.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        // Update "Select Flavor: [Name]" label
        const flavorLabel = section.querySelector('[data-flavor-current-name]');
        if (flavorLabel) flavorLabel.textContent = optionValue;

        updateVariant();
      });
    });

    const updateQuantity = (value) => {
      const parsed = Math.max(1, parseInt(value || '1', 10) || 1);
      if (qtyDisplay) qtyDisplay.value = parsed;
      if (qtyInput) qtyInput.value = parsed;
      const variant = variants.find(entry => String(entry.id) === variantInput.value);
      updatePurchase();
    };

    if (qtyMinus) {
      qtyMinus.addEventListener('click', () => {
        updateQuantity((parseInt(qtyDisplay.value, 10) || 1) - 1);
      });
    }
    if (qtyPlus) {
      qtyPlus.addEventListener('click', () => {
        updateQuantity((parseInt(qtyDisplay.value, 10) || 1) + 1);
      });
    }
    if (qtyDisplay) {
      qtyDisplay.addEventListener('change', () => updateQuantity(qtyDisplay.value));
    }

    thumbButtons.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const image = thumb.dataset.image;
        if (image && mainImage) {
          mainImage.src = image;
          mainImage.alt = thumb.querySelector('img')?.alt || '';
        }
        thumbButtons.forEach((btn) => btn.classList.remove('is-active'));
        thumb.classList.add('is-active');
      });
    });

    updateVariant();

    // ── Nutrition Label Drawer ─────────────────────────────────
    const nutDrawer = document.getElementById('HxNutriDrawer-{{ section.id }}');
    const nutToggle = section.querySelector('[data-hx-nutrition-toggle]');

    if (nutDrawer && nutToggle) {
      let previousOverflow = '';
      let drawerOpener = nutToggle;
      const openNutDrawer = () => {
        if (nutDrawer.open) return;
        previousOverflow = document.body.style.overflow;
        drawerOpener = document.activeElement instanceof HTMLElement ? document.activeElement : nutToggle;
        nutDrawer.showModal();
        nutDrawer.setAttribute('aria-hidden', 'false');
        nutToggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        const closeBtn = nutDrawer.querySelector('[data-hx-nutrition-close]:not(.hx-nutri-drawer__overlay)');
        if (closeBtn) setTimeout(() => closeBtn.focus(), 50);
      };

      const closeNutDrawer = () => {
        nutDrawer.close();
        nutDrawer.setAttribute('aria-hidden', 'true');
        nutToggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = previousOverflow;
        drawerOpener.focus({preventScroll: true});
      };

      nutDrawer.addEventListener('cancel', (event) => { event.preventDefault(); closeNutDrawer(); });
      nutToggle.addEventListener('click', openNutDrawer);

      nutDrawer.querySelectorAll('[data-hx-nutrition-close]').forEach((el) => {
        el.addEventListener('click', closeNutDrawer);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nutDrawer.getAttribute('aria-hidden') === 'false') {
          closeNutDrawer();
        }
        if (e.key === 'Tab' && nutDrawer.getAttribute('aria-hidden') === 'false') {
          const focusable = Array.from(nutDrawer.querySelectorAll('button, a[href], summary, input, select, textarea, [tabindex="0"]'))
            .filter(el => !el.disabled && el.getClientRects().length > 0);
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (first && e.shiftKey && (document.activeElement === first || !nutDrawer.contains(document.activeElement))) {
            e.preventDefault();
            last.focus();
          } else if (last && !e.shiftKey && (document.activeElement === last || !nutDrawer.contains(document.activeElement))) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }
  });
</script>

