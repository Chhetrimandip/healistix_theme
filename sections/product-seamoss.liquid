{{ 'section-product-seamoss.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign initial_variant = product.selected_or_first_available_variant
  assign option_count = product.options_with_values | size
  assign selected_options_string = initial_variant.options | join: '||'
  assign selling_plan_group = product.selling_plan_groups | first
  assign initial_plan_id = ''
  if selling_plan_group and selling_plan_group.selling_plans.size > 0
    assign initial_plan_id = selling_plan_group.selling_plans.first.id
  endif
  assign logo_blocks = section.blocks | where: 'type', 'logo'
  assign bundle_blocks = section.blocks | where: 'type', 'bundle'
  assign flavor_blocks = section.blocks | where: 'type', 'flavor'
  assign promo_blocks = section.blocks | where: 'type', 'promo'
  assign info_tabs = section.blocks | where: 'type', 'info_tab'
-%}

<section
  id="ProductSeamoss-{{ section.id }}"
  class="product-seamoss"
  data-section-id="{{ section.id }}"
  data-option-count="{{ option_count }}"
  data-selected-options="{{ selected_options_string | escape }}"
>
  <div class="product-seamoss__container page-width">
    <div class="product-seamoss__layout">
      <div class="product-seamoss__media">
        <div class="product-seamoss__media-main">
          {%- if product.featured_media -%}
            {%- assign featured_image = product.featured_media | image_url: width: 900 -%}
            <img
              src="{{ featured_image }}"
              alt="{{ product.featured_media.alt | escape }}"
              loading="eager"
              width="{{ product.featured_media.width }}"
              height="{{ product.featured_media.height }}"
              data-product-media-main
            >
          {%- else -%}
            <img
              src="https://dummyimage.com/900x900/F5F5F5/BBBBBB&text=Sea+Moss+Gel"
              alt="{{ product.title }}"
              loading="lazy"
              width="900"
              height="900"
              data-product-media-main
            >
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="product-seamoss__media-thumbs">
            {%- for media in product.media limit: 6 -%}
              {%- assign thumb_src = media | image_url: width: 400 -%}
              <button
                type="button"
                class="product-seamoss__media-thumb{% if forloop.first %} is-active{% endif %}"
                data-product-thumb
                data-image="{{ thumb_src }}"
                aria-label="Show {{ media.alt | default: product.title }}"
              >
                <img src="{{ thumb_src }}" alt="{{ media.alt | escape }}">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if promo_blocks.size > 0 -%}
          <div class="product-seamoss__promo-grid">
            {%- for block in promo_blocks -%}
              <div class="product-seamoss__promo-card" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 320 }}" alt="{{ block.settings.title | escape }}">
                {%- endif -%}
                <div class="product-seamoss__promo-copy">
                  {%- if block.settings.eyebrow != blank -%}
                    <p class="product-seamoss__promo-eyebrow">{{ block.settings.eyebrow }}</p>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <p class="product-seamoss__promo-title">{{ block.settings.title }}</p>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="product-seamoss__promo-text">{{ block.settings.text }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product-seamoss__details">
        <p class="product-seamoss__eyebrow">{{ section.settings.eyebrow_text }}</p>
        <h1 class="product-seamoss__title">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading }}
          {%- else -%}
            {{ product.title }}
          {%- endif -%}
        </h1>
        <div class="product-seamoss__reviews">
          <svg width="96" height="16" viewBox="0 0 96 16" role="presentation" aria-hidden="true">
            <g fill="#FBBF24">
              <polygon points="8 0 10.2 5.3 16 6 12 9.9 13 16 8 13.1 3 16 4 9.9 0 6 5.8 5.3 8 0"></polygon>
              <polygon points="28 0 30.2 5.3 36 6 32 9.9 33 16 28 13.1 23 16 24 9.9 20 6 25.8 5.3 28 0"></polygon>
              <polygon points="48 0 50.2 5.3 56 6 52 9.9 53 16 48 13.1 43 16 44 9.9 40 6 45.8 5.3 48 0"></polygon>
              <polygon points="68 0 70.2 5.3 76 6 72 9.9 73 16 68 13.1 63 16 64 9.9 60 6 65.8 5.3 68 0"></polygon>
              <polygon points="88 0 90.2 5.3 96 6 92 9.9 93 16 88 13.1 83 16 84 9.9 80 6 85.8 5.3 88 0"></polygon>
            </g>
          </svg>
          <span>{{ section.settings.review_text }}</span>
        </div>
        <p class="product-seamoss__subtext">{{ section.settings.review_subtext }}</p>

        {%- if section.settings.support_points != blank -%}
          <div class="product-seamoss__support-row">
            {%- assign points = section.settings.support_points | split: '|' -%}
            {%- for point in points -%}
              <div class="product-seamoss__support-item">
                <span>✓</span>
                <span>{{ point | strip }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if logo_blocks.size > 0 -%}
          <div class="product-seamoss__logos">
            {%- for block in section.blocks -%}
              {%- if block.type == 'logo' and block.settings.image != blank -%}
                <div class="product-seamoss__logo" {{ block.shopify_attributes }}>
                  <img src="{{ block.settings.image | image_url: width: 160 }}" alt="{{ block.settings.alt_text | escape }}">
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- assign has_badges = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            {%- assign has_badges = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_badges -%}
          <div class="product-seamoss__badges">
            {%- for block in section.blocks -%}
              {%- if block.type == 'badge' -%}
                <div class="product-seamoss__badge" {{ block.shopify_attributes }}>
                  <span class="product-seamoss__badge-title">{{ block.settings.title }}</span>
                  <span class="product-seamoss__badge-subtitle">{{ block.settings.subtitle }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- assign form_id = 'ProductSeamossForm-' | append: section.id -%}
        {%- form 'product', product, id: form_id, class: 'product-seamoss__form', novalidate: 'novalidate', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ initial_variant.id }}" data-product-variant-input>
          <input type="hidden" name="quantity" value="1" data-quantity-input>
          <input type="hidden" name="selling_plan" value="{{ initial_plan_id }}" data-selling-plan-input>

          {%- assign step_index = 0 -%}
          {%- for option in product.options_with_values -%}
            {%- assign step_index = step_index | plus: 1 -%}
            <div class="product-seamoss__step" data-option-block>
              <div class="product-seamoss__step-label">0{{ step_index }}</div>
              <h3>Choose {{ option.name | downcase }}</h3>
              <p class="product-seamoss__step-note">{{ section.settings.option_helper }}</p>
              <div class="product-seamoss__swipe-hint">
                <svg class="product-seamoss__swipe-hand" width="36" height="36" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
