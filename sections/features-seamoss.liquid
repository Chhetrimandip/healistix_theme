{{ 'section-features-seamoss.css' | asset_url | stylesheet_tag }}

<div id="Features-{{ section.id }}" class="features-seamoss color-{{ section.settings.color_scheme }} gradient">
  <div class="features-seamoss__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="features-seamoss__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    
    <div class="features-seamoss__layout">
      <div class="features-seamoss__column features-seamoss__column--left">
        {%- for block in section.blocks limit:3 -%}
          <div class="features-seamoss__item" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h3 class="features-seamoss__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="features-seamoss__description">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      
      <div class="features-seamoss__center">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 600 }}" 
               alt="{{ section.settings.heading }}"
               class="features-seamoss__image"
               loading="lazy">
        {%- else -%}
          <div class="features-seamoss__image-placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'features-seamoss__image-placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
      
      <div class="features-seamoss__column features-seamoss__column--right">
        {%- for block in section.blocks offset:3 -%}
          <div class="features-seamoss__item" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h3 class="features-seamoss__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="features-seamoss__description">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% style %}
  #Features-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Features Sea Moss",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Makes Sea Moss Special"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Center Product Image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Feature description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features Sea Moss",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Wildcrafted Ocean Algae",
            "description": "Sustainably harvested from pristine ocean waters."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Designed By Nature",
            "description": "Carries minerals and nutrients in whole-food form."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Trusted By Generations",
            "description": "A staple in coastal diets for thousands of years."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Antioxidant Power",
            "description": "Helps defend cells with antioxidants like vitamins A & C."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Digestive Health",
            "description": "Supports a balanced microbiome with natural prebiotics."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "All-Day Energy",
            "description": "Helps sustain natural energy with ocean minerals."
          }
        }
      ]
    }
  ]
}
{% endschema %}
