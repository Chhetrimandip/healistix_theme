{{ 'section-homepage-healistix.css' | asset_url | stylesheet_tag }}

<div class="hx-faq" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="hx-faq__container">
    {% if section.settings.eyebrow != blank %}
      <div class="hx-faq__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="hx-faq__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="hx-faq__list">
      {% for block in section.blocks %}
        {% if block.type == 'question' %}
          <details class="hx-faq__item" {{ block.shopify_attributes }}>
            <summary class="hx-faq__question">
              <span class="hx-faq__question-text">{{ block.settings.question }}</span>
              <span class="hx-faq__toggle">+</span>
            </summary>
            <div class="hx-faq__answer">
              <p>{{ block.settings.answer }}</p>
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.bottom_cta_label != blank %}
      <div class="hx-faq__cta-wrap">
        <a href="{{ section.settings.bottom_cta_link }}" class="hx-faq__cta">
          {{ section.settings.bottom_cta_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Common Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything You Need to Know" },
    { "type": "text", "id": "bottom_cta_label", "label": "Bottom CTA Label" },
    { "type": "url", "id": "bottom_cta_link", "label": "Bottom CTA Link" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0, "max": 100, "step": 10, "default": 80, "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0, "max": 100, "step": 10, "default": 80, "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do I take sea moss gel?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Take one tablespoon daily, straight or mixed into smoothies, tea, or juice." }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
