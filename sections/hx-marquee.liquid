{{ 'section-homepage-healistix.css' | asset_url | stylesheet_tag }}

<div class="hx-marquee" style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="hx-marquee__container">
    <div class="hx-marquee__track">
      {% for block in section.blocks %}
        <div class="hx-marquee__badge" {{ block.shopify_attributes }}>
          <span class="hx-marquee__badge-text">{{ block.settings.text }}</span>
        </div>
      {% endfor %}
    </div>
    <!-- Duplicate track for seamless infinite scroll -->
    <div class="hx-marquee__track" aria-hidden="true">
      {% for block in section.blocks %}
        <div class="hx-marquee__badge">
          <span class="hx-marquee__badge-text">{{ block.settings.text }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Marquee - Trust Badges",
  "class": "section-hx-marquee",
  "settings": [
    {
      "type": "color",
      "id": "color_scheme",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "default": "NON GMO"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee - Trust Badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "text": "NON GMO"
          }
        },
        {
          "type": "badge",
          "settings": {
            "text": "DAIRY FREE"
          }
        },
        {
          "type": "badge",
          "settings": {
            "text": "GLUTEN FREE"
          }
        },
        {
          "type": "badge",
          "settings": {
            "text": "ORGANIC"
          }
        }
      ]
    }
  ]
}
{% endschema %}
