{{ 'section-homepage-healistix.css' | asset_url | stylesheet_tag }}

<div class="hx-why" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="hx-why__container">
    {% if section.settings.eyebrow != blank %}
      <div class="hx-why__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="hx-why__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="hx-why__comparison">
      <div class="hx-why__column hx-why__column--us">
        <div class="hx-why__column-header">{{ section.settings.us_label }}</div>
        {% for block in section.blocks %}
          {% if block.type == 'comparison_row' %}
            <div class="hx-why__row">
              <span class="hx-why__check">✓</span>
              <span class="hx-why__row-text">{{ block.settings.us_text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="hx-why__column hx-why__column--them">
        <div class="hx-why__column-header">{{ section.settings.them_label }}</div>
        {% for block in section.blocks %}
          {% if block.type == 'comparison_row' %}
            <div class="hx-why__row">
              <span class="hx-why__x">✗</span>
              <span class="hx-why__row-text">{{ block.settings.them_text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if section.settings.bottom_text != blank %}
      <p class="hx-why__bottom-text">{{ section.settings.bottom_text }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Why Healistix",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Healistix Standard" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not All Sea Moss Is Created Equal" },
    { "type": "text", "id": "us_label", "label": "Our Column Label", "default": "Healistix" },
    { "type": "text", "id": "them_label", "label": "Their Column Label", "default": "Most Brands" },
    { "type": "textarea", "id": "bottom_text", "label": "Bottom Text" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0, "max": 100, "step": 10, "default": 80, "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0, "max": 100, "step": 10, "default": 80, "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Comparison Row",
      "settings": [
        { "type": "text", "id": "us_text", "label": "Healistix", "default": "Wildcrafted from the Atlantic" },
        { "type": "text", "id": "them_text", "label": "Most Brands", "default": "Pool-grown in factories" }
      ]
    }
  ],
  "presets": [{ "name": "Why Healistix" }]
}
{% endschema %}
