{{ 'section-product-seamoss.css' | asset_url | stylesheet_tag }}

<div id="ProductReviewsWidget-{{ section.id }}" class="product-reviews-widget">
  <div class="page-width">
    <div class="product-reviews-widget__header">
      <h2 class="product-reviews-widget__title">{{ section.settings.heading }}</h2>
      <p class="product-reviews-widget__subtitle">{{ section.settings.subheading }}</p>
    </div>
    <div class="product-reviews-widget__embed">
      {%- if section.settings.embed_html != blank -%}
        {{ section.settings.embed_html }}
      {%- elsif product != blank -%}
        <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget"
          data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}"
          data-product-id="{{ product.id }}" data-widget="review" data-auto-install="false"
          data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}"
          data-entry-point="review_widget.js" data-entry-key="review-widget/main.js">
          {% if product.metafields.judgeme.widget.size > 20 %}
            <div class="jdgm-legacy-widget-content" style="display: none;">{{ product.metafields.judgeme.widget }}</div>
          {% endif %}
        </div>
        {% if product.metafields.judgeme.review_widget_data %}
          <script>
            window.jdgm = window.jdgm || {};
            jdgm.data ||= {};
            jdgm.data.reviewWidget ||= {};
            jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }};
          </script>
        {% endif %}
      {%- elsif section.settings.placeholder_text != blank -%}
        <p>{{ section.settings.placeholder_text }}</p>
      {%- else -%}
        <p>Add your review app snippet or metafield here.</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Reviews Widget",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews"},
    {"type": "textarea", "id": "subheading", "label": "Subheading"},
    {"type": "richtext", "id": "embed_html", "label": "Embed HTML", "info": "Paste your review widget snippet."},
    {"type": "textarea", "id": "placeholder_text", "label": "Placeholder text", "default": "This is where Judge.me, Yotpo, or your preferred review widget will appear."}
  ],
  "presets": [
    {"name": "Product Reviews Widget"}
  ]
}
{% endschema %}
