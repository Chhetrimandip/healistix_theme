{{ 'batana-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'batana-page.js' | asset_url }}" defer></script>

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign offer_blocks = section.blocks | where: 'type', 'offer'
  assign accordion_blocks = section.blocks | where: 'type', 'accordion'
  assign ship_date = 'now' | date: '%s' | plus: 172800 | date: '%-d %B'
-%}

<section id="batana-buy" class="bt-section bt-main" data-section-id="{{ section.id }}">
  <div class="bt-container">
    <div class="bt-main__layout">

      <div class="bt-main__media">
        <div class="bt-main__media-main">
          {%- if product.featured_media -%}
            <img
              src="{{ product.featured_media | image_url: width: 1000 }}"
              alt="{{ product.featured_media.alt | default: product.title | escape }}"
              width="{{ product.featured_media.width }}"
              height="{{ product.featured_media.height }}"
              loading="eager"
              data-bt-media-main
            >
          {%- else -%}
            <div class="bt-main__media-placeholder">{{ product.title | default: 'Batana Oil' }}</div>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="bt-main__thumbs">
            {%- for media in product.media limit: 6 -%}
              <button
                type="button"
                class="bt-main__thumb{% if forloop.first %} is-active{% endif %}"
                data-bt-thumb
                data-image="{{ media | image_url: width: 1000 }}"
                aria-label="Show image {{ forloop.index }}"
              >
                <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" loading="lazy" width="200" height="200">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="bt-main__details">
        {%- if section.settings.flag_text != blank -%}
          <div class="bt-main__flag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></svg>
            {{ section.settings.flag_text }}
          </div>
        {%- endif -%}

        {%- if section.settings.chip_1 != blank or section.settings.chip_2 != blank -%}
          <div class="bt-main__chips">
            {%- if section.settings.chip_1 != blank -%}
              <span class="bt-main__chip bt-main__chip--orange">{{ section.settings.chip_1 }}</span>
            {%- endif -%}
            {%- if section.settings.chip_2 != blank -%}
              <span class="bt-main__chip bt-main__chip--teal">{{ section.settings.chip_2 }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.review_text != blank -%}
          <div class="bt-main__stars">
            <svg width="96" height="16" viewBox="0 0 96 16" role="presentation" aria-hidden="true">
              <g fill="#F5B942">
                <polygon points="8 0 10.2 5.3 16 6 12 9.9 13 16 8 13.1 3 16 4 9.9 0 6 5.8 5.3 8 0"></polygon>
                <polygon points="28 0 30.2 5.3 36 6 32 9.9 33 16 28 13.1 23 16 24 9.9 20 6 25.8 5.3 28 0"></polygon>
                <polygon points="48 0 50.2 5.3 56 6 52 9.9 53 16 48 13.1 43 16 44 9.9 40 6 45.8 5.3 48 0"></polygon>
                <polygon points="68 0 70.2 5.3 76 6 72 9.9 73 16 68 13.1 63 16 64 9.9 60 6 65.8 5.3 68 0"></polygon>
                <polygon points="88 0 90.2 5.3 96 6 92 9.9 93 16 88 13.1 83 16 84 9.9 80 6 85.8 5.3 88 0"></polygon>
              </g>
            </svg>
            <span>{{ section.settings.review_text }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.eyebrow_text != blank -%}
          <span class="bt-main__eyebrow">{{ section.settings.eyebrow_text }}</span>
        {%- endif -%}
        <h1 class="bt-main__title">
          {%- if section.settings.heading != blank -%}{{ section.settings.heading }}{%- else -%}{{ product.title }}{%- endif -%}
        </h1>

        {%- if section.settings.description != blank -%}
          <p class="bt-main__desc">{{ section.settings.description }}</p>
        {%- endif -%}

        {%- if benefit_blocks.size > 0 -%}
          <div class="bt-main__benefits">
            {%- for block in benefit_blocks -%}
              <div class="bt-main__benefit" {{ block.shopify_attributes }}>
                {%- case block.settings.icon -%}
                  {%- when 'growth' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V8"/><path d="M12 8c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6z"/><path d="M12 14c0-3-2-5-5-5 0 3 2 5 5 5z"/></svg>
                  {%- when 'scalp' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a7 7 0 0 1 7 7c0 2-1 3.5-2 5l-1 6h-8l-1-6c-1-1.5-2-3-2-5a7 7 0 0 1 7-7z"/></svg>
                  {%- when 'elastic' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12c3-6 6 6 9 0s6 6 9 0"/></svg>
                  {%- when 'shine' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/><circle cx="12" cy="12" r="3"/></svg>
                  {%- when 'strength' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.7C9 7 5.5 10.6 5.5 14.5a6.5 6.5 0 0 0 13 0C18.5 10.6 15 7 12 2.7z"/></svg>
                {%- endcase -%}
                <span>{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- assign form_id = 'BtProductForm-' | append: section.id -%}
        {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="{{ offer_blocks.first.settings.quantity | default: 1 }}" data-bt-qty>

          {%- if offer_blocks.size > 0 -%}
            <div class="bt-offers" data-bt-offers data-unit-price="{{ variant.price }}" data-unit-compare="{{ variant.compare_at_price | default: 0 }}">
              {%- for block in offer_blocks -%}
                <button
                  type="button"
                  class="bt-offer{% if forloop.first %} is-active{% endif %}"
                  data-bt-offer
                  data-quantity="{{ block.settings.quantity | default: 1 }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.badge != blank -%}
                    <span class="bt-offer__badge">{{ block.settings.badge }}</span>
                  {%- endif -%}
                  <span class="bt-offer__radio" aria-hidden="true"></span>
                  <span class="bt-offer__body">
                    <span class="bt-offer__label">{{ block.settings.label }}</span>
                    {%- if block.settings.sublabel != blank -%}
                      <span class="bt-offer__sublabel">{{ block.settings.sublabel }}</span>
                    {%- endif -%}
                  </span>
                  <span class="bt-offer__prices">
                    <span class="bt-offer__price">
                      {%- if block.settings.price_text != blank -%}
                        {{ block.settings.price_text }}
                      {%- else -%}
                        {%- assign line_price = variant.price | times: block.settings.quantity -%}
                        {{ line_price | money }}
                      {%- endif -%}
                    </span>
                    {%- if block.settings.compare_text != blank -%}
                      <span class="bt-offer__compare">{{ block.settings.compare_text }}</span>
                    {%- elsif variant.compare_at_price > variant.price -%}
                      {%- assign line_compare = variant.compare_at_price | times: block.settings.quantity -%}
                      <span class="bt-offer__compare">{{ line_compare | money }}</span>
                    {%- endif -%}
                  </span>
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if section.settings.subscription_title != blank -%}
            <div class="bt-main__subnote">
              <div>
                <strong>{{ section.settings.subscription_title }}</strong>
                <span>{{ section.settings.subscription_note }}</span>
              </div>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#c75b12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
            </div>
          {%- endif -%}

          {%- if section.settings.show_ship_date -%}
            <p class="bt-main__ship">*Today's orders ship by: {{ ship_date }}</p>
          {%- endif -%}

          <button
            type="submit"
            class="bt-btn bt-btn--wide"
            {% unless variant.available %}disabled{% endunless %}
          >
            {%- if variant.available -%}{{ section.settings.button_label }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
          </button>
          <div class="bt-main__errors" role="alert"></div>

          {%- if section.settings.show_payment_icons -%}
            <div class="bt-main__payments">
              {%- for type in shop.enabled_payment_types -%}
                {{ type | payment_type_svg_tag: class: 'bt-main__payment-icon' }}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endform -%}

        {%- if accordion_blocks.size > 0 -%}
          <div class="bt-acc">
            {%- for block in accordion_blocks -%}
              <details {% if block.settings.open_default %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>{{ block.settings.title }}</summary>
                <div class="bt-acc__body">
                  {%- if block.settings.image != blank -%}
                    <img
                      class="bt-acc__image"
                      src="{{ block.settings.image | image_url: width: 1200 }}"
                      alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                      loading="lazy"
                      width="1200"
                      height="{{ 1200 | divided_by: block.settings.image.aspect_ratio | round }}"
                    >
                    {%- unless block.settings.hide_text_with_image -%}
                      {{ block.settings.content }}
                    {%- endunless -%}

                  {%- elsif block.settings.layout == 'steps' -%}
                    <div class="bt-acc-steps">
                      {%- assign steps = block.settings.items | newline_to_br | split: '<br />' -%}
                      {%- for step in steps -%}
                        {%- assign trimmed = step | strip -%}
                        {%- if trimmed != blank -%}
                          <div class="bt-acc-step">
                            <span class="bt-acc-step__num">{{ forloop.index }}</span>
                            <span class="bt-acc-step__label">{{ trimmed }}</span>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                  {%- elsif block.settings.layout == 'compare' -%}
                    <div class="bt-acc-compare">
                      <div class="bt-acc-compare__col bt-acc-compare__col--ours">
                        <div class="bt-acc-compare__head">{{ block.settings.compare_ours_title }}</div>
                        <ul>
                          {%- assign ours = block.settings.items | newline_to_br | split: '<br />' -%}
                          {%- for line in ours -%}
                            {%- assign trimmed = line | strip -%}
                            {%- if trimmed != blank -%}<li>{{ trimmed }}</li>{%- endif -%}
                          {%- endfor -%}
                        </ul>
                      </div>
                      <div class="bt-acc-compare__col bt-acc-compare__col--theirs">
                        <div class="bt-acc-compare__head">{{ block.settings.compare_theirs_title }}</div>
                        <ul>
                          {%- assign theirs = block.settings.items_secondary | newline_to_br | split: '<br />' -%}
                          {%- for line in theirs -%}
                            {%- assign trimmed = line | strip -%}
                            {%- if trimmed != blank -%}<li>{{ trimmed }}</li>{%- endif -%}
                          {%- endfor -%}
                        </ul>
                      </div>
                    </div>

                  {%- elsif block.settings.layout == 'icons' -%}
                    <div class="bt-acc-icons">
                      {%- assign rows = block.settings.items | newline_to_br | split: '<br />' -%}
                      {%- for row in rows -%}
                        {%- assign trimmed = row | strip -%}
                        {%- if trimmed != blank -%}
                          <div class="bt-acc-icons__row">
                            <span class="bt-acc-icons__check" aria-hidden="true"></span>
                            <span>
                              {%- if trimmed contains ': ' -%}
                                {%- assign label = trimmed | split: ': ' | first -%}
                                {%- assign rest = trimmed | remove_first: label | remove_first: ': ' -%}
                                <strong>{{ label }}:</strong> {{ rest }}
                              {%- else -%}
                                {{ trimmed }}
                              {%- endif -%}
                            </span>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>

                  {%- else -%}
                    {{ block.settings.content }}
                  {%- endif -%}
                </div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.getElementById('batana-buy');
    if (!section) return;

    var qtyInput = section.querySelector('[data-bt-qty]');
    var offers = section.querySelectorAll('[data-bt-offer]');
    offers.forEach(function (offer) {
      offer.addEventListener('click', function () {
        offers.forEach(function (o) { o.classList.remove('is-active'); });
        offer.classList.add('is-active');
        if (qtyInput) qtyInput.value = offer.dataset.quantity || '1';
      });
    });

    var mainImage = section.querySelector('[data-bt-media-main]');
    section.querySelectorAll('[data-bt-thumb]').forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        if (mainImage && thumb.dataset.image) mainImage.src = thumb.dataset.image;
        section.querySelectorAll('[data-bt-thumb]').forEach(function (t) { t.classList.remove('is-active'); });
        thumb.classList.add('is-active');
      });
    });
  });
</script>

{% schema %}
{
  "name": "Batana — Main product",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "flag_text", "label": "Flag banner text", "default": "REAL BATANA. RAW & UNREFINED." },
    { "type": "text", "id": "chip_1", "label": "Label chip 1 (orange)", "default": "100% PURE OIL" },
    { "type": "text", "id": "chip_2", "label": "Label chip 2 (teal)", "default": "UNREFINED" },
    { "type": "text", "id": "eyebrow_text", "label": "Eyebrow above title", "default": "HONDURAN MIRACLE OIL" },
    { "type": "text", "id": "review_text", "label": "Review line", "default": "Rated 5 stars by verified customers" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to product title when empty." },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "text", "id": "subscription_title", "label": "Subscription note title", "default": "Save more with automatic refills" },
    { "type": "text", "id": "subscription_note", "label": "Subscription note text", "default": "Zero commitment. Cancel anytime." },
    { "type": "checkbox", "id": "show_ship_date", "label": "Show estimated ship-by date", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment method icons", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "ADD TO CART" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit icon",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "growth", "label": "Growth (sprout)" },
            { "value": "scalp", "label": "Scalp (drop)" },
            { "value": "elastic", "label": "Elasticity (wave)" },
            { "value": "shine", "label": "Shine (sun)" },
            { "value": "strength", "label": "Strength (shield)" },
            { "value": "drop", "label": "Oil drop" }
          ],
          "default": "growth"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "SUPPORTS GROWTH" }
      ]
    },
    {
      "type": "offer",
      "name": "Bundle offer",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "1 Jar" },
        { "type": "text", "id": "sublabel", "label": "Sublabel" },
        { "type": "text", "id": "badge", "label": "Badge (e.g. Most Popular)" },
        { "type": "number", "id": "quantity", "label": "Cart quantity", "default": 1 },
        { "type": "text", "id": "price_text", "label": "Price override text", "info": "Leave empty to auto-calculate quantity × product price." },
        { "type": "text", "id": "compare_text", "label": "Compare-at override text", "info": "Leave empty to auto-calculate from the product compare-at price." }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "BENEFITS" },
        { "type": "image_picker", "id": "image", "label": "Infographic image", "info": "Overrides everything below when set." },
        { "type": "checkbox", "id": "hide_text_with_image", "label": "Hide other content when image is set", "default": true },
        {
          "type": "select",
          "id": "layout",
          "label": "Visual layout (when no image)",
          "options": [
            { "value": "text", "label": "Plain text" },
            { "value": "icons", "label": "Icon checklist" },
            { "value": "steps", "label": "Numbered steps" },
            { "value": "compare", "label": "Ours vs theirs" }
          ],
          "default": "text"
        },
        { "type": "textarea", "id": "items", "label": "Items (one per line)", "info": "Used by icon checklist, numbered steps, and the left (ours) compare column." },
        { "type": "textarea", "id": "items_secondary", "label": "Compare: right column items (one per line)" },
        { "type": "text", "id": "compare_ours_title", "label": "Compare: left title", "default": "PURE BATANA OIL" },
        { "type": "text", "id": "compare_theirs_title", "label": "Compare: right title", "default": "FAKE BATANA OIL" },
        { "type": "richtext", "id": "content", "label": "Plain text content", "default": "<p><strong>Best for:</strong> Describe who this is for.</p>" },
        { "type": "checkbox", "id": "open_default", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Batana — Main product" }]
}
{% endschema %}
