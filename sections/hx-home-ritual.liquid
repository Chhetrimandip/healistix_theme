<section class="hx-home-ritual hx-home-wrap" aria-labelledby="HomeRitual-{{ section.id }}">
  <div class="hx-home-ritual__image">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(max-width: 749px) 100vw, 50vw', loading: 'lazy' }}
    {%- else -%}
      <img src="{{ 'hx-home-ritual-v1.jpg' | asset_url }}" width="1254" height="1254" alt="Healistix Mango Sea Moss Gel beside a mango smoothie and fresh fruit" loading="lazy">
    {%- endif -%}
  </div>
  <div class="hx-home-ritual__copy">
    <p class="hx-home-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 id="HomeRitual-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <p class="hx-home-intro">{{ section.settings.text | escape }}</p>
    <ol class="hx-home-ritual__steps">
      {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><span aria-hidden="true">0{{ forloop.index }}</span><div><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p></div></li>{%- endfor -%}
    </ol>
    <a class="hx-home-button" href="{{ section.settings.product.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>
  </div>
</section>
{% schema %}
{"name":"Healistix — Daily ritual","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SMALL RITUAL. BIG FLAVOR."},{"type":"text","id":"heading","label":"Heading","default":"Make room for a little goodness."},{"type":"textarea","id":"text","label":"Text","default":"Your morning smoothie. Your favorite breakfast bowl. Your own way to enjoy sea moss."},{"type":"image_picker","id":"image","label":"Lifestyle image"},{"type":"product","id":"product","label":"Linked product"},{"type":"text","id":"button_label","label":"Button label","default":"Find my flavor"}],"blocks":[{"type":"step","name":"Ritual step","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Text"}]}],"max_blocks":3,"presets":[{"name":"Healistix — Daily ritual"}]}
{% endschema %}
