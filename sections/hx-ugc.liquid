{{ 'section-homepage-healistix.css' | asset_url | stylesheet_tag }}

<div class="hx-ugc" style="padding: {{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px;">
  <div class="hx-ugc__container">
    {% if section.settings.eyebrow %}
      <div class="hx-ugc__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading %}
      <h2 class="hx-ugc__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subtitle %}
      <p class="hx-ugc__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}

    <div class="hx-ugc__grid">
      {% for block in section.blocks %}
        {% if block.type == 'video' %}
          <div class="hx-ugc__card" {{ block.shopify_attributes }}>
            <div class="hx-ugc__video-wrapper">
              {% if block.settings.thumbnail %}
                <img
                  class="hx-ugc__thumbnail"
                  src="{{ block.settings.thumbnail | image_url: width: 300 }}"
                  alt="Video thumbnail"
                  loading="lazy"
                />
              {% endif %}

              {% if block.settings.video_url %}
                <a class="hx-ugc__play-button" href="{{ block.settings.video_url }}" target="_blank" rel="noopener noreferrer" aria-label="Play video">
                  <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="32" cy="32" r="32" fill="white" fill-opacity="0.9"/>
                    <path d="M26 22L26 42L44 32L26 22Z" fill="currentColor"/>
                  </svg>
                </a>
              {% endif %}
            </div>

            <div class="hx-ugc__meta">
              {% if block.settings.username %}
                <p class="hx-ugc__username">{{ block.settings.username }}</p>
              {% endif %}

              {% if block.settings.product_name %}
                <p class="hx-ugc__product-name">{{ block.settings.product_name }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "UGC Video Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Customer Love"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See It In Action"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Real customers sharing their Healistix experience"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding Right",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "username",
          "label": "Username",
          "default": "@username"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Name",
          "default": "Product Name"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Video Thumbnail"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC Video Testimonials",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
