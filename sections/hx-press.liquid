{{ 'section-homepage-healistix.css' | asset_url | stylesheet_tag }}

<div class="hx-press" style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="hx-press__wrapper">
    {% if section.settings.label_text != blank %}
      <h2 class="hx-press__label">{{ section.settings.label_text }}</h2>
    {% endif %}
    
    <div class="hx-press__grid">
      {% for block in section.blocks %}
        <div class="hx-press__item" {{ block.shopify_attributes }}>
          {% if block.settings.logo != blank %}
            <div class="hx-press__logo">
              {{ block.settings.logo | image_url: width: 200 | image_tag: loading: 'lazy', alt: block.settings.name }}
            </div>
          {% else %}
            <div class="hx-press__name">{{ block.settings.name }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Press - As Featured In",
  "class": "section-hx-press",
  "settings": [
    {
      "type": "text",
      "id": "label_text",
      "label": "Section Label",
      "default": "As Featured In"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "publication",
      "name": "Publication",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Publication Name",
          "default": "Publication Name"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Publication Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press - As Featured In",
      "blocks": [
        {
          "type": "publication",
          "settings": {
            "name": "Forbes"
          }
        },
        {
          "type": "publication",
          "settings": {
            "name": "Vogue"
          }
        },
        {
          "type": "publication",
          "settings": {
            "name": "The New York Times"
          }
        },
        {
          "type": "publication",
          "settings": {
            "name": "GQ"
          }
        }
      ]
    }
  ]
}
{% endschema %}
