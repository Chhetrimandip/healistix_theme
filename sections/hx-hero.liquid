{{ 'section-homepage-healistix.css' | asset_url | stylesheet_tag }}

<div class="hx-hero">
  <!-- Brand Bar -->
  <div class="hx-hero__brand-bar">
    <div class="hx-hero__brand-bar-left">HEALISTIX®</div>
    <div class="hx-hero__brand-bar-right">WHOLISTIC HEALING</div>
  </div>

  <!-- Main Body -->
  <div class="hx-hero__body">
    <!-- Text Side -->
    <div class="hx-hero__content">
      {% if section.settings.badge_text %}
        <div class="hx-hero__badge">{{ section.settings.badge_text }}</div>
      {% endif %}

      <h1 class="hx-hero__heading">
        <span class="hx-hero__heading-text">{{ section.settings.heading_line_1 }}</span>
        <span class="hx-hero__heading-highlight">{{ section.settings.heading_highlight_1 }}</span>
        <br>
        <span class="hx-hero__heading-text">{{ section.settings.heading_line_2 }}</span>
        <span class="hx-hero__heading-highlight">{{ section.settings.heading_highlight_2 }}</span>
      </h1>

      {% if section.settings.subtitle %}
        <p class="hx-hero__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      <div class="hx-hero__claim">
        <div class="hx-hero__claim-text">{{ section.settings.claim_text }}</div>
        <div class="hx-hero__claim-rating">⭐⭐⭐⭐⭐ ({{ section.settings.review_count }} reviews)</div>
      </div>

      <div class="hx-hero__buttons">
        {% if section.settings.button_label_1 and section.settings.button_link_1 %}
          <a href="{{ section.settings.button_link_1 }}" class="hx-hero__button hx-hero__button--primary">
            {{ section.settings.button_label_1 }}
          </a>
        {% endif %}

        {% if section.settings.button_label_2 and section.settings.button_link_2 %}
          <a href="{{ section.settings.button_link_2 }}" class="hx-hero__button hx-hero__button--quiz">
            <span class="hx-hero__button-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2l2.39 4.84L20 8l-4 3.9.94 5.5L12 14.77 7.06 17.4 8 11.9 4 8l5.61-1.16L12 2z" fill="currentColor"/>
              </svg>
            </span>
            <span class="hx-hero__button-text">
              <span class="hx-hero__button-label">{{ section.settings.button_label_2 }}</span>
              {% if section.settings.button_sublabel_2 != blank %}
                <span class="hx-hero__button-sublabel">{{ section.settings.button_sublabel_2 }}</span>
              {% endif %}
            </span>
            <span class="hx-hero__button-arrow" aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>

      {% if section.settings.guarantee_text %}
        <div class="hx-hero__guarantee">{{ section.settings.guarantee_text }}</div>
      {% endif %}
    </div>

    <!-- Product Side -->
    <div class="hx-hero__product">
      {% if section.settings.product_image %}
        <img
          src="{{ section.settings.product_image | image_url: width: 600 }}"
          alt="{{ section.settings.product_image_caption }}"
          class="hx-hero__product-image"
        >
        {% if section.settings.product_image_caption %}
          <p class="hx-hero__product-caption">{{ section.settings.product_image_caption }}</p>
        {% endif %}
      {% else %}
        <div class="hx-hero__product-placeholder">
          <p>Product Image</p>
        </div>
      {% endif %}
    </div>

    {% assign has_beyond = false %}
    {% for block in section.blocks %}
      {% if block.type == 'beyond_item' %}
        {% assign has_beyond = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_beyond %}
      <div class="hx-hero__beyond">
        <span class="hx-hero__beyond-label">{{ section.settings.beyond_label | default: 'Also in the lineup' }}</span>
        <div class="hx-hero__beyond-pills">
          {% for block in section.blocks %}
            {% if block.type == 'beyond_item' %}
              <a
                href="{{ block.settings.link | default: '#' }}"
                class="hx-hero__beyond-pill hx-hero__beyond-pill--{{ block.settings.color_theme }}"
                {{ block.shopify_attributes }}
              >
                <span class="hx-hero__beyond-pill-dot"></span>
                <span class="hx-hero__beyond-pill-name">{{ block.settings.name }}</span>
                {% if block.settings.tag != blank %}
                  <span class="hx-hero__beyond-pill-tag">{{ block.settings.tag }}</span>
                {% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>

  <!-- Trust Strip -->
  {% if section.blocks.size > 0 %}
    <div class="hx-hero__trust-strip">
      {% for block in section.blocks %}
        {% if block.type == 'trust_item' %}
          <div class="hx-hero__trust-item" {{ block.shopify_attributes }}>
            <span class="hx-hero__trust-text">{{ block.settings.text }}</span>
            {% if block.settings.highlight %}
              <span class="hx-hero__trust-highlight">{{ block.settings.highlight }}</span>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <div class="hx-hero__trust-strip">
      <div class="hx-hero__trust-item">
        <span class="hx-hero__trust-text">Wildcrafted</span>
        <span class="hx-hero__trust-highlight">St. Lucia</span>
      </div>
      <div class="hx-hero__trust-item">
        <span class="hx-hero__trust-text">92</span>
        <span class="hx-hero__trust-highlight">Minerals</span>
      </div>
      <div class="hx-hero__trust-item">
        <span class="hx-hero__trust-text">No</span>
        <span class="hx-hero__trust-highlight">Sugar Added</span>
      </div>
      <div class="hx-hero__trust-item">
        <span class="hx-hero__trust-text">Crafted in</span>
        <span class="hx-hero__trust-highlight">Family Owned</span>
      </div>
    </div>
  {% endif %}
</div>

<!-- Sticky Bottom CTA -->
<div class="hx-sticky-cta" id="hx-sticky-cta">
  <span class="hx-sticky-cta__text"><strong>Trinity Sea Moss Gel</strong> — $19.99</span>
  <a href="/products/sebi-trinity-sea-moss-gel" class="hx-sticky-cta__button">
    Shop Now →
  </a>
</div>

<script>
  (function() {
    var stickyCta = document.getElementById('hx-sticky-cta');
    if (!stickyCta) return;
    var hero = document.querySelector('.hx-hero');
    if (!hero) return;
    var threshold = hero.offsetTop + hero.offsetHeight;
    window.addEventListener('scroll', function() {
      if (window.scrollY > threshold) {
        stickyCta.classList.add('is-visible');
      } else {
        stickyCta.classList.remove('is-visible');
      }
    }, { passive: true });
  })();
</script>

{% style %}
  .hx-hero {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

