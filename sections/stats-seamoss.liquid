{{ 'section-stats-seamoss.css' | asset_url | stylesheet_tag }}

{%- assign top_row_limit = 2 -%}

<div id="Stats-{{ section.id }}" class="stats-seamoss color-{{ section.settings.color_scheme }} gradient">
  <div class="stats-seamoss__container page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="stats-seamoss__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    
    <div class="stats-seamoss__grid">
      {%- for block in section.blocks limit: top_row_limit -%}
        {%- assign card_index = forloop.index -%}
        <div class="stats-seamoss__item stats-seamoss__item--card-{{ card_index }}" {{ block.shopify_attributes }}>
          <div class="stats-seamoss__content">
            {%- if block.settings.number != blank -%}
              <div class="stats-seamoss__number">{{ block.settings.number }}</div>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <div class="stats-seamoss__label">{{ block.settings.label }}</div>
            {%- endif -%}
          </div>
          {%- if block.settings.icon != blank -%}
            <div class="stats-seamoss__icon">{{ block.settings.icon }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    
    <div class="stats-seamoss__grid-bottom">
      {%- for block in section.blocks offset: top_row_limit -%}
        {%- assign card_index = forloop.index | plus: top_row_limit -%}
        <div class="stats-seamoss__item stats-seamoss__item--card-{{ card_index }}" {{ block.shopify_attributes }}>
          <div class="stats-seamoss__content">
            {%- if block.settings.number != blank -%}
              <div class="stats-seamoss__number">{{ block.settings.number }}</div>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <div class="stats-seamoss__label">{{ block.settings.label }}</div>
            {%- endif -%}
          </div>
          {%- if block.settings.icon != blank -%}
            <div class="stats-seamoss__icon">{{ block.settings.icon }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  #Stats-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Stats Sea Moss",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "460+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Sprouts Shops and Retail Chains"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon Emoji",
          "default": "🏪",
          "info": "Add an emoji icon (e.g., 🏪, 🌍, 📱, 📹, 📦)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats Sea Moss",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "460+",
            "label": "Sprouts Shops and Retail Chains",
            "icon": "🏪"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "500k+",
            "label": "Happy customers globally",
            "icon": "🌍"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "100k+",
            "label": "Active subscribers who trust our brand",
            "icon": "📱"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "250M",
            "label": "Views on social media",
            "icon": "📹"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "#1",
            "label": "Best Seller Amazon",
            "icon": "📦"
          }
        }
      ]
    }
  ]
}
{% endschema %}
