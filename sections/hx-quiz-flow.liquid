      goals: answers.goals.join(','),
      symptoms: answers.symptoms.join(','),
      lifestyle: answers.lifestyle,
      experience: answers.experience
    });

    goTo('results');
  }

  /* Fetch product image from Shopify AJAX API */
  function fetchProductImage(handle, imgElementId) {
    fetch('/products/' + handle + '.json')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.product && data.product.image && data.product.image.src) {
          var img = document.getElementById(imgElementId);
          if (img) {
            img.src = data.product.image.src;
            img.alt = data.product.title;
          }
        }
      })
      .catch(function() { /* silently fail — placeholder stays */ });
  }

  /* ===== GA4 EVENTS ===== */
  function fireEvent(name, params) {
    if (typeof gtag === 'function') {
      gtag('event', name, params || {});
    }
    console.log('[HX Quiz]', name, params || {});
  }

  /* ===== COPY CODE ===== */
  function setupCopy() {
    var copyBtn = document.getElementById('quizCopyBtn');
    if (!copyBtn) return;
    copyBtn.addEventListener('click', function() {
      var code = document.getElementById('quizDiscountCode').textContent;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(code).then(function() {
          copyBtn.textContent = 'Copied!';
          setTimeout(function() { copyBtn.textContent = 'Copy Code'; }, 2000);
        });
      }
    });
  }

  /* ===== INIT ===== */
  function init() {
    setupOptionClicks();
    setupCopy();
    updateProgress();

    document.getElementById('quizStartBtn').addEventListener('click', function() {
      fireEvent('quiz_start');
      goTo('q1');
    });

    root.querySelectorAll('[data-back="true"]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        goBack();
      });
    });

    root.querySelectorAll('.hx-quiz-flow__next-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var forScreen = this.dataset.nextFor;
        var questionMap = { q1: 'goals', q2: 'symptoms' };
        var question = questionMap[forScreen];
        if (question) {
          fireEvent('quiz_question_answered', { question: question, value: answers[question].join(',') });
        }
        goTo(screens[currentIdx + 1]);
      });
    });

    document.getElementById('quizEmailForm').addEventListener('submit', function(e) {
      e.preventDefault();
      email = document.getElementById('quizEmailInput').value;
      fireEvent('quiz_email_captured', { email_provided: true });

      document.getElementById('quizDiscountBox').style.display = 'block';
      document.getElementById('quizDiscountCode').textContent = 'SEAMOSS20';

      showResults();
    });

    document.getElementById('quizSkipEmail').addEventListener('click', function() {
      fireEvent('quiz_email_captured', { email_provided: false });
      showResults();
    });

    document.getElementById('quizRetakeBtn').addEventListener('click', function() {
      answers = { goals: [], symptoms: [], lifestyle: null, experience: null, method: null };
      root.querySelectorAll('.hx-quiz-flow__option--selected').forEach(function(el) {
        el.classList.remove('hx-quiz-flow__option--selected');
      });
      root.querySelectorAll('.hx-quiz-flow__next-btn').forEach(function(btn) {
        btn.disabled = true;
      });
      document.getElementById('quizSecondaryResult').style.display = 'none';
      document.getElementById('quizDiscountBox').style.display = 'none';
      document.getElementById('quizWhyBox').style.display = 'none';
      document.getElementById('quizFlavorPick').style.display = 'none';
      document.getElementById('quizProfileTags').innerHTML = '';
      document.getElementById('quizWhyList').innerHTML = '';
      document.getElementById('quizResultHeadline').textContent = 'We found your match.';
      document.getElementById('quizResultSubline').textContent = 'Based on your goals and lifestyle, here\'s what our herbalist recommends.';
      goTo('landing');
    });

    document.getElementById('quizResultCta').addEventListener('click', function() {
      fireEvent('quiz_cta_clicked', { blend: document.getElementById('quizResultFlavor').textContent });
    });

    preserveUtms();
  }

  function preserveUtms() {
    var params = new URLSearchParams(window.location.search);
    var utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
    var utms = {};
    utmKeys.forEach(function(k) {
      if (params.get(k)) utms[k] = params.get(k);
    });
    if (Object.keys(utms).length > 0) {
      try { sessionStorage.setItem('hx_quiz_utms', JSON.stringify(utms)); } catch(e) {}
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

