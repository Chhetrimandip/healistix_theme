  /* ===== SCORING ENGINE ===== */
  function computeTherapeuticScores() {
    /* Only score therapeutic blends */
    var scores = {};
    therapeuticBlends.forEach(function(f) { scores[f] = 0; });

    /* 1. Goals — heaviest weight */
    answers.goals.forEach(function(g) {
      var map = goalScores[g];
      if (map) Object.keys(map).forEach(function(f) {
        if (scores[f] !== undefined) scores[f] += map[f];
      });
    });

    /* 2. Symptoms */
    answers.symptoms.forEach(function(s) {
      var map = symptomScores[s];
      if (map) Object.keys(map).forEach(function(f) {
        if (scores[f] !== undefined) scores[f] += map[f];
      });
    });

    /* 3. Lifestyle */
    if (answers.lifestyle) {
      var lmap = lifestyleScores[answers.lifestyle];
      if (lmap) Object.keys(lmap).forEach(function(f) {
        if (scores[f] !== undefined) scores[f] += lmap[f];
      });
    }

    /* 4. Experience — adjusts therapeutic blend weighting */
    if (answers.experience) {
      var emap = experienceTherapeuticScores[answers.experience];
      if (emap) Object.keys(emap).forEach(function(f) {
        if (scores[f] !== undefined) scores[f] += emap[f];
      });
    }

    return scores;
  }

  function resolveRecommendation() {
    var scores = computeTherapeuticScores();

    /* Compute goal-only scores for tiebreaking (goals = strongest herbal intent) */
    var goalOnly = {};
    therapeuticBlends.forEach(function(f) { goalOnly[f] = 0; });
    answers.goals.forEach(function(g) {
      var map = goalScores[g];
      if (map) Object.keys(map).forEach(function(f) {
        if (goalOnly[f] !== undefined) goalOnly[f] += map[f];
      });
    });

    /* Sort therapeutic blends by total score, break ties with goal-only score */
    var sorted = therapeuticBlends.slice().sort(function(a, b) {
      var diff = scores[b] - scores[a];
      if (diff !== 0) return diff;
      return goalOnly[b] - goalOnly[a];
    });

    var primaryKey = sorted[0];
    var secondaryKey = sorted[1];

    /* Only show secondary if it actually scored meaningfully (not zero) */
    var showSecondary = scores[secondaryKey] > 0 && secondaryKey !== primaryKey;

    /* Pick a fruit flavor based on method and experience (separate logic) */
    var flavorKey = pickFlavor();

    /* Build rationale from herbal fragments */
    var reason = buildRationale(primaryKey);
    var secondaryReason = showSecondary ? buildRationale(secondaryKey, true) : '';

    return {
      primary: primaryKey,
      secondary: showSecondary ? secondaryKey : null,
      flavor: flavorKey,
      reason: reason,
      secondaryReason: secondaryReason,
      whyPoints: buildWhyPoints(primaryKey)
    };
  }

  function pickFlavor() {
    /* If they mix into food, unflavored makes most sense regardless */
    if (answers.method === 'food') return 'irish-moss';

    /* Method is the primary driver for flavor preference */
    var flavor = flavorByMethod[answers.method] || 'strawberry';

    /* Daily users prefer unflavored; experience adjusts the pick */
    if (answers.experience === 'daily') return 'irish-moss';

    /* "Some" experience users get a different option from the default */
    if (answers.experience === 'some' && answers.method !== 'smoothie') return 'blueberry';

    return flavor;
  }

  function buildRationale(key, short) {
    var herb = herbalRationale[key];
    if (!herb) return '';
    if (short) return herb.base;

    var parts = [herb.base];
    var contextKeys = []
      .concat(answers.goals)
      .concat(answers.symptoms)
      .concat(answers.lifestyle ? [answers.lifestyle] : [])
      .concat(answers.experience ? [answers.experience] : []);

    var added = 0;
    contextKeys.forEach(function(k) {
      if (herb.why[k] && added < 2) {
        parts.push(herb.why[k]);
        added++;
      }
    });

    return parts.join(' ');
  }

  function buildWhyPoints(key) {
    var herb = herbalRationale[key];
    if (!herb || !herb.why) return [];

    var points = [];
    var contextKeys = []
      .concat(answers.goals)
      .concat(answers.symptoms)
      .concat(answers.lifestyle ? [answers.lifestyle] : [])
      .concat(answers.experience ? [answers.experience] : []);

    contextKeys.forEach(function(k) {
      if (herb.why[k]) points.push(herb.why[k]);
    });

    return points.slice(0, 3);
  }

  /* ===== NAVIGATION ===== */
  function goTo(screenName) {
    var allScreens = root.querySelectorAll('.hx-quiz-flow__screen');
    for (var i = 0; i < allScreens.length; i++) {
      allScreens[i].classList.remove('hx-quiz-flow__screen--active');
    }
    var target = root.querySelector('[data-screen="' + screenName + '"]');
    if (target) target.classList.add('hx-quiz-flow__screen--active');

    currentIdx = screens.indexOf(screenName);
    updateProgress();
    root.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function goBack() {
    if (currentIdx > 0) goTo(screens[currentIdx - 1]);
  }

  function updateProgress() {
    var totalQuestions = 5;
    var questionMap = { q1: 1, q2: 2, q3: 3, q4: 4, q5: 5 };
    var current = screens[currentIdx];
    var pct = 0;
    var text = '';

    if (current === 'landing') {
      pct = 0; text = '';
    } else if (questionMap[current]) {
      pct = (questionMap[current] / totalQuestions) * 80;
      text = questionMap[current] + ' of ' + totalQuestions;
    } else if (current === 'email') {
      pct = 90; text = 'Almost there!';
    } else if (current === 'results') {
      pct = 100; text = 'Complete!';
    }

    progressFill.style.width = pct + '%';
    progressText.textContent = text;
    root.querySelector('.hx-quiz-flow__progress').style.display = current === 'landing' ? 'none' : 'flex';
  }

  /* ===== OPTION CLICKS ===== */
  function setupOptionClicks() {
    var optionGroups = root.querySelectorAll('.hx-quiz-flow__options');
    optionGroups.forEach(function(group) {
      var question = group.dataset.question;
      var isMulti = group.classList.contains('hx-quiz-flow__options--multi');
      var maxSelect = parseInt(group.dataset.max) || 99;

      group.querySelectorAll('.hx-quiz-flow__option').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var val = this.dataset.value;

          if (isMulti) {
            /* Handle "none" as exclusive option in symptoms */
            if (question === 'symptoms' && val === 'none') {
              group.querySelectorAll('.hx-quiz-flow__option').forEach(function(b) {
                b.classList.remove('hx-quiz-flow__option--selected');
              });
              this.classList.add('hx-quiz-flow__option--selected');
              answers[question] = ['none'];
            } else if (question === 'symptoms') {
              var noneBtn = group.querySelector('[data-value="none"]');
              if (noneBtn) noneBtn.classList.remove('hx-quiz-flow__option--selected');
              answers[question] = answers[question].filter(function(v) { return v !== 'none'; });

              if (this.classList.contains('hx-quiz-flow__option--selected')) {
                this.classList.remove('hx-quiz-flow__option--selected');
                answers[question] = answers[question].filter(function(v) { return v !== val; });
              } else {
                var selected = group.querySelectorAll('.hx-quiz-flow__option--selected');
                if (selected.length >= maxSelect) return;
                this.classList.add('hx-quiz-flow__option--selected');
                answers[question].push(val);
              }
            } else {
              if (this.classList.contains('hx-quiz-flow__option--selected')) {
                this.classList.remove('hx-quiz-flow__option--selected');
                answers[question] = answers[question].filter(function(v) { return v !== val; });
              } else {
                var selected = group.querySelectorAll('.hx-quiz-flow__option--selected');
                if (selected.length >= maxSelect) return;
                this.classList.add('hx-quiz-flow__option--selected');
                answers[question].push(val);
              }
            }

            var nextBtn = root.querySelector('[data-next-for="' + screens[currentIdx] + '"]');
            if (nextBtn) {
              nextBtn.disabled = answers[question].length === 0;
            }

          } else {
            group.querySelectorAll('.hx-quiz-flow__option').forEach(function(b) {
              b.classList.remove('hx-quiz-flow__option--selected');
            });
            this.classList.add('hx-quiz-flow__option--selected');
            answers[question] = val;

            fireEvent('quiz_question_answered', { question: question, value: val });

            setTimeout(function() {
              goTo(screens[currentIdx + 1]);
            }, 300);
          }
        });
      });
    });
  }

  /* ===== RESULTS ===== */
  function showResults() {
    var rec = resolveRecommendation();
    var primary = products[rec.primary];

    /* ===== Personalized headline based on goals ===== */
    var goalHeadlines = {
