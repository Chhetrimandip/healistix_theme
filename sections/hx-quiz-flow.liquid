      'mood': 'Mood swings', 'insomnia': 'Sleep issues', 'none': 'Preventive',
      'active': 'Active lifestyle', 'moderate': 'Moderate activity', 'sedentary': 'Sedentary',
      'high-stress': 'High-stress', 'first-time': 'New to sea moss', 'some': 'Some experience',
