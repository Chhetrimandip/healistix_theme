    var goalNames = { 'energy': 'energy', 'digestion': 'digestion', 'immunity': 'immunity', 'skin': 'skin & hair', 'recovery': 'recovery', 'focus': 'focus', 'hormonal': 'hormonal balance', 'sleep': 'sleep' };
    var goalList = answers.goals.map(function(g) { return goalNames[g] || g; });
