    }

    /* ===== Social proof — match testimonial to product ===== */
    var testimonials = {
      'turmeric': { quote: 'I\'ve tried everything for my joints — turmeric capsules, fish oil, you name it. This gel is the first thing that actually made a difference I could feel within a week.', name: 'Keisha M.', stars: 5 },
      'elderberry': { quote: 'Cold season used to wreck me every year. I\'ve been taking the elderberry blend daily for three months now and haven\'t been sick once.', name: 'Marcus T.', stars: 5 },
      'elderberry-ginger': { quote: 'My digestion has never been better. The ginger really works — I notice the difference on days I forget to take it.', name: 'Daniella R.', stars: 5 },
      'trinity': { quote: 'This is the one. I feel more balanced, my energy is steady all day, and my skin is clearing up. The trinity blend covers everything.', name: 'Jasmine W.', stars: 5 },
