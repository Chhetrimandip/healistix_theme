      'soursop': { quote: 'My mom put me onto soursop and I was skeptical, but this blend is legit. My inflammation went way down in two weeks.', name: 'Brianna C.', stars: 5 },
      'sea-grape': { quote: 'I didn\'t expect much but the sea grape blend has been amazing for my skin. People keep asking what I\'m doing differently.', name: 'Tanya L.', stars: 5 },
      'pineapple-ginger': { quote: 'Perfect for after the gym. The ginger helps with soreness and the pineapple makes it actually taste good. Win-win.', name: 'Devon H.', stars: 5 }
    };
    var testimonial = testimonials[rec.primary] || testimonials['trinity'];
    document.getElementById('quizProofQuote').textContent = '"' + testimonial.quote + '"';
    document.getElementById('quizProofName').textContent = '— ' + testimonial.name + ', Verified Buyer';

    /* ===== Secondary therapeutic blend ===== */
    if (rec.secondary) {
      var secondary = products[rec.secondary];
      var secEl = document.getElementById('quizSecondaryResult');
      secEl.style.display = 'block';
      document.getElementById('quizSecondaryFlavor').textContent = secondary.name;
      document.getElementById('quizSecondaryReason').textContent = rec.secondaryReason;
