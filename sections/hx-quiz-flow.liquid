    };
    var allTags = [].concat(answers.goals, answers.symptoms, answers.lifestyle ? [answers.lifestyle] : [], answers.experience ? [answers.experience] : []);
    allTags.forEach(function(tag) {
      if (tagLabels[tag]) {
        var span = document.createElement('span');
        span.className = 'hx-quiz-flow__r-tag';
        span.textContent = tagLabels[tag];
        profileTags.appendChild(span);
      }
    });

    /* ===== Why points — herbal rationale ===== */
    var whyList = document.getElementById('quizWhyList');
    whyList.innerHTML = '';
    if (rec.whyPoints.length > 0) {
      document.getElementById('quizWhyBox').style.display = 'block';
      rec.whyPoints.forEach(function(point) {
        var li = document.createElement('li');
        li.textContent = point;
        whyList.appendChild(li);
