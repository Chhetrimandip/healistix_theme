    fetchProductImage(primary.handle, 'quizResultImg');

    /* ===== Profile tags ===== */
    var profileTags = document.getElementById('quizProfileTags');
    profileTags.innerHTML = '';
    var tagLabels = {
      'energy': 'Energy', 'digestion': 'Digestion', 'immunity': 'Immunity', 'skin': 'Skin & Hair',
      'recovery': 'Recovery', 'focus': 'Focus', 'hormonal': 'Hormonal', 'sleep': 'Sleep',
      'crashes': 'Energy crashes', 'bloating': 'Bloating', 'colds': 'Frequent colds',
