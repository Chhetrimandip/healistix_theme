{{ 'section-homepage-healistix.css' | asset_url | stylesheet_tag }}

<div class="hx-results" style="padding: {{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px;">
  <div class="hx-results__container">
    {% if section.settings.eyebrow %}
      <div class="hx-results__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading %}
      <h2 class="hx-results__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subtitle %}
      <p class="hx-results__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}

    <div class="hx-results__grid">
      {% for block in section.blocks %}
        {% if block.type == 'result' %}
          <div class="hx-results__card" {{ block.shopify_attributes }}>
            <div class="hx-results__images">
              {% if block.settings.before_image %}
                <div class="hx-results__image hx-results__image--before">
                  {% if block.settings.before_image %}
                    {{ block.settings.before_image | image_url: width: 400 | image_tag: alt: 'Before' }}
                  {% endif %}
                </div>
              {% endif %}

              <div class="hx-results__divider">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>

              {% if block.settings.after_image %}
                <div class="hx-results__image hx-results__image--after">
                  {% if block.settings.after_image %}
                    {{ block.settings.after_image | image_url: width: 400 | image_tag: alt: 'After' }}
                  {% endif %}
                </div>
              {% endif %}
            </div>

            <div class="hx-results__caption">
              {% if block.settings.product_name %}
                <h3 class="hx-results__product-name">{{ block.settings.product_name }}</h3>
              {% endif %}

              {% if block.settings.timeframe %}
                <p class="hx-results__timeframe">{{ block.settings.timeframe }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Before & After Results",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Real Results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Transformations"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "See the visible difference our products make"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding Right",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "result",
      "name": "Result",
      "settings": [
        {
          "type": "image_picker",
          "id": "before_image",
          "label": "Before Image"
        },
        {
          "type": "image_picker",
          "id": "after_image",
          "label": "After Image"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Name",
          "default": "Product Name"
        },
        {
          "type": "text",
          "id": "timeframe",
          "label": "Timeframe",
          "default": "8 weeks of daily use"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Before & After Results",
      "blocks": [
        { "type": "result" },
        { "type": "result" },
        { "type": "result" }
      ]
    }
  ]
}
{% endschema %}
