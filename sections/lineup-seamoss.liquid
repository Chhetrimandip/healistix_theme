{%- liquid
  assign section_id = 'Lineup-' | append: section.id
-%}

<div id="{{ section_id }}" class="lineup-seamoss color-{{ section.settings.color_scheme }} gradient">
  <div class="lineup-seamoss__container">

    {%- if section.settings.eyebrow != blank -%}
      <p class="lineup-seamoss__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="lineup-seamoss__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="lineup-seamoss__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="lineup-seamoss__tabs" role="tablist" aria-label="Healistix lineup">
      <button type="button"
              class="lineup-seamoss__tab is-active"
              role="tab"
              aria-selected="true"
              aria-controls="{{ section_id }}-panel-flavors"
              id="{{ section_id }}-tab-flavors"
              data-lineup-tab="flavors">
        <span class="lineup-seamoss__tab-count">17</span>
        <span class="lineup-seamoss__tab-label">{{ section.settings.flavors_tab_label | default: 'Flavors' }}</span>
      </button>
      <button type="button"
              class="lineup-seamoss__tab"
              role="tab"
              aria-selected="false"
              aria-controls="{{ section_id }}-panel-blends"
              id="{{ section_id }}-tab-blends"
              data-lineup-tab="blends">
        <span class="lineup-seamoss__tab-count">{{ section.blocks.size }}</span>
        <span class="lineup-seamoss__tab-label">{{ section.settings.blends_tab_label | default: 'Herbal Blends' }}</span>
      </button>
    </div>

    {%- comment -%} ---------------- FLAVORS PANEL ---------------- {%- endcomment -%}
    <div class="lineup-seamoss__panel is-active"
         id="{{ section_id }}-panel-flavors"
         role="tabpanel"
         aria-labelledby="{{ section_id }}-tab-flavors"
         data-lineup-panel="flavors">

      {%- assign flavors = 'Raw,Banana,Blueberry,Dragon Fruit,Grape,Honey,Honeydew,Lychee,Mango,Orange,Passion Fruit,Peach,Pineapple,Red Guava,Rose,Strawberry,Watermelon' | split: ',' -%}
      {%- assign flavor_colors = '#E8DCC0,#F5D76E,#4A5FA5,#E8427C,#6B3E7A,#D4931C,#B8D88E,#F5C4C6,#F39324,#E86B1F,#E8B73C,#F5A57C,#F5D14A,#D63A3A,#E88FA8,#C7312F,#E05C5C' | split: ',' -%}
      {%- assign flavor_notes = 'Unflavored Trinity base,Sweet & creamy,Antioxidant sweet-tart,Tropical & floral,Deep & jammy,Mellow & golden,Crisp melon,Delicate floral,Rich tropical,Bright citrus,Tropical tang,Soft stone-fruit,Bright tropical,Tropical pink,Soft floral,Classic berry,Summer sweet' | split: ',' -%}

      <div class="lineup-seamoss__flavors-grid">
        {%- for flavor in flavors -%}
          {%- assign idx = forloop.index0 -%}
          <div class="lineup-seamoss__flavor-card">
            <div class="lineup-seamoss__flavor-swatch" style="--swatch-color: {{ flavor_colors[idx] }};">
              <span class="lineup-seamoss__flavor-swatch-inner"></span>
            </div>
            <div class="lineup-seamoss__flavor-text">
              <h3 class="lineup-seamoss__flavor-name">{{ flavor | strip }}</h3>
              <p class="lineup-seamoss__flavor-note">{{ flavor_notes[idx] | strip }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <p class="lineup-seamoss__panel-footnote">
        Every flavor is the same wildcrafted Trinity base — sea moss, bladderwrack, burdock root, spring water — finished with real fruit. No syrups, no artificial flavorings.
      </p>
    </div>

    {%- comment -%} ---------------- BLENDS PANEL ---------------- {%- endcomment -%}
    <div class="lineup-seamoss__panel"
         id="{{ section_id }}-panel-blends"
         role="tabpanel"
         aria-labelledby="{{ section_id }}-tab-blends"
         data-lineup-panel="blends"
         hidden>

      <div class="lineup-seamoss__blends-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'blend' -%}
            {%- assign blend_href = block.settings.link | default: '#' -%}
            <a class="lineup-seamoss__blend-card" href="{{ blend_href }}" {{ block.shopify_attributes }}>
              {%- if block.settings.focus != blank -%}
                <span class="lineup-seamoss__blend-focus">{{ block.settings.focus }}</span>
              {%- endif -%}
              {%- if block.settings.name != blank -%}
                <h3 class="lineup-seamoss__blend-name">{{ block.settings.name }}</h3>
              {%- endif -%}
              {%- if block.settings.herbs != blank -%}
                <p class="lineup-seamoss__blend-herbs">{{ block.settings.herbs }}</p>
              {%- endif -%}
              {%- if block.settings.use_case != blank -%}
                <p class="lineup-seamoss__blend-use">{{ block.settings.use_case }}</p>
              {%- endif -%}
              <span class="lineup-seamoss__blend-arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <p class="lineup-seamoss__panel-footnote">
        Each blend starts with the same wildcrafted Trinity base and layers in targeted herbs for a specific goal. Same small family kitchen, same four-ingredient rule on the base.
      </p>
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="lineup-seamoss__cta-row">
        <a class="lineup-seamoss__cta" href="{{ section.settings.cta_link | default: '/collections/all' }}">
          {{ section.settings.cta_label }}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% style %}
  #{{ section_id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--hx-cream, #FBF7F0);
  }
  #{{ section_id }} .lineup-seamoss__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }
  #{{ section_id }} .lineup-seamoss__eyebrow {
    font-family: var(--hx-sans, inherit);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--hx-coral, #E8502A);
    margin: 0 0 16px;
  }
  #{{ section_id }} .lineup-seamoss__heading {
    font-family: var(--hx-serif, inherit);
    font-size: clamp(32px, 4vw, 52px) !important;
    font-weight: 700;
    line-height: 1.1;
    color: var(--hx-navy, #0A1628);
    margin: 0 auto 16px;
    max-width: 820px;
  }
  #{{ section_id }} .lineup-seamoss__subheading {
    font-family: var(--hx-sans, inherit);
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.5;
    color: rgba(10, 22, 40, 0.72);
    margin: 0 auto 40px;
    max-width: 640px;
  }

  /* ---- Tabs ---- */
  #{{ section_id }} .lineup-seamoss__tabs {
    display: inline-flex;
    gap: 8px;
    background: rgba(10, 22, 40, 0.06);
    padding: 6px;
    border-radius: 999px;
    margin: 0 auto 44px;
  }
  #{{ section_id }} .lineup-seamoss__tab {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(10, 22, 40, 0.6);
    font-family: var(--hx-sans, inherit);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.18s, color 0.18s, box-shadow 0.18s;
  }
  #{{ section_id }} .lineup-seamoss__tab:hover {
    color: var(--hx-navy, #0A1628);
  }
  #{{ section_id }} .lineup-seamoss__tab.is-active {
    background: #ffffff;
    color: var(--hx-navy, #0A1628);
    box-shadow: 0 2px 10px rgba(10, 22, 40, 0.08);
  }
  #{{ section_id }} .lineup-seamoss__tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 22px;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--hx-coral, #E8502A);
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
  }
  #{{ section_id }} .lineup-seamoss__tab.is-active .lineup-seamoss__tab-count {
    background: var(--hx-navy, #0A1628);
  }

  /* ---- Panels ---- */
  #{{ section_id }} .lineup-seamoss__panel {
    display: none;
  }
  #{{ section_id }} .lineup-seamoss__panel.is-active {
    display: block;
  }

  /* ---- Flavors grid ---- */
  #{{ section_id }} .lineup-seamoss__flavors-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    margin-bottom: 28px;
  }
  #{{ section_id }} .lineup-seamoss__flavor-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 1px 3px rgba(10, 22, 40, 0.06);
    text-align: left;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  #{{ section_id }} .lineup-seamoss__flavor-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(10, 22, 40, 0.12);
  }
  #{{ section_id }} .lineup-seamoss__flavor-swatch {
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--swatch-color, #F2E9D8);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 -4px 10px rgba(0,0,0,0.12), inset 0 2px 6px rgba(255,255,255,0.35);
  }
  #{{ section_id }} .lineup-seamoss__flavor-swatch-inner {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgba(255,255,255,0.45);
  }
  #{{ section_id }} .lineup-seamoss__flavor-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  #{{ section_id }} .lineup-seamoss__flavor-name {
    font-family: var(--hx-sans, inherit);
    font-size: 15px !important;
    font-weight: 700;
    color: var(--hx-navy, #0A1628);
    margin: 0;
    line-height: 1.2;
  }
  #{{ section_id }} .lineup-seamoss__flavor-note {
    font-family: var(--hx-sans, inherit);
    font-size: 12px;
    color: rgba(10, 22, 40, 0.58);
    margin: 0;
    line-height: 1.3;
  }

  /* ---- Blends grid ---- */
  #{{ section_id }} .lineup-seamoss__blends-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 28px;
    text-align: left;
  }
  #{{ section_id }} .lineup-seamoss__blend-card {
    position: relative;
    display: block;
    padding: 28px 26px;
    background: #ffffff;
    border-radius: 18px;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 1px 3px rgba(10, 22, 40, 0.06);
    transition: transform 0.2s, box-shadow 0.2s;
    border: 1px solid rgba(10, 22, 40, 0.05);
  }
  #{{ section_id }} .lineup-seamoss__blend-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(10, 22, 40, 0.14);
    border-color: rgba(232, 80, 42, 0.22);
  }
  #{{ section_id }} .lineup-seamoss__blend-focus {
    display: inline-block;
    font-family: var(--hx-sans, inherit);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--hx-coral, #E8502A);
    margin-bottom: 10px;
  }
  #{{ section_id }} .lineup-seamoss__blend-name {
    font-family: var(--hx-serif, inherit);
    font-size: 22px !important;
    font-weight: 700;
    color: var(--hx-navy, #0A1628);
    margin: 0 0 10px;
    line-height: 1.2;
  }
  #{{ section_id }} .lineup-seamoss__blend-herbs {
    font-family: var(--hx-sans, inherit);
    font-size: 13px;
    font-weight: 600;
    color: var(--hx-gold, #C8860A);
    margin: 0 0 10px;
    line-height: 1.4;
  }
  #{{ section_id }} .lineup-seamoss__blend-use {
    font-family: var(--hx-sans, inherit);
    font-size: 14px;
    color: rgba(10, 22, 40, 0.72);
    margin: 0;
    line-height: 1.5;
  }
  #{{ section_id }} .lineup-seamoss__blend-arrow {
    position: absolute;
    top: 24px;
    right: 24px;
    font-size: 18px;
    color: rgba(10, 22, 40, 0.3);
    transition: color 0.2s, transform 0.2s;
  }
  #{{ section_id }} .lineup-seamoss__blend-card:hover .lineup-seamoss__blend-arrow {
    color: var(--hx-coral, #E8502A);
    transform: translateX(3px);
  }

  /* ---- Footnote + CTA ---- */
  #{{ section_id }} .lineup-seamoss__panel-footnote {
    font-family: var(--hx-sans, inherit);
    font-size: 13px;
    color: rgba(10, 22, 40, 0.55);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.55;
    font-style: italic;
  }
  #{{ section_id }} .lineup-seamoss__cta-row {
    margin-top: 40px;
  }
  #{{ section_id }} .lineup-seamoss__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 36px;
    background: var(--hx-navy, #0A1628);
    color: #ffffff;
    font-family: var(--hx-sans, inherit);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.3px;
    text-decoration: none;
    border-radius: 999px;
    transition: background 0.2s, transform 0.2s;
  }
  #{{ section_id }} .lineup-seamoss__cta:hover {
    background: var(--hx-coral, #E8502A);
    transform: translateY(-1px);
  }

  /* ---- Responsive ---- */
  @media (max-width: 1024px) {
    #{{ section_id }} .lineup-seamoss__flavors-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    #{{ section_id }} .lineup-seamoss__blends-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    #{{ section_id }} .lineup-seamoss__flavors-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    #{{ section_id }} .lineup-seamoss__blends-grid {
      grid-template-columns: 1fr;
    }
    #{{ section_id }} .lineup-seamoss__flavor-card {
      padding: 14px 14px;
    }
    #{{ section_id }} .lineup-seamoss__flavor-swatch {
      width: 36px;
      height: 36px;
    }
    #{{ section_id }} .lineup-seamoss__tab {
      padding: 12px 20px;
      font-size: 14px;
    }
  }
{% endstyle %}

<script>
  (function() {
    var root = document.getElementById('{{ section_id }}');
    if (!root) return;
    var tabs = root.querySelectorAll('[data-lineup-tab]');
    var panels = root.querySelectorAll('[data-lineup-panel]');
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var target = tab.getAttribute('data-lineup-tab');
        tabs.forEach(function(t) {
          var active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach(function(p) {
          var active = p.getAttribute('data-lineup-panel') === target;
          p.classList.toggle('is-active', active);
          if (active) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', ''); }
        });
      });
    });
  })();
</script>

{% schema %}
{
