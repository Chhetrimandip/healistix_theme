          "default": "A one-sentence description of what this blend is for."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lineup Sea Moss",
      "blocks": [
        { "type": "blend", "settings": { "focus": "THE ORIGINAL", "name": "Sebi Trinity", "herbs": "Sea moss + Bladderwrack + Burdock", "use_case": "The flagship Trinity jar \u2014 three herbs Dr. Sebi grouped as a nutritional trinity, in one wildcrafted gel." } },
        { "type": "blend", "settings": { "focus": "IMMUNITY", "name": "Immunity Blend", "herbs": "Sea moss + Elderberry + Echinacea", "use_case": "Daily immune support layered on the Trinity base \u2014 built for cold-season mornings." } },
