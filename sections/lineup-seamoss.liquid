        { "type": "blend", "settings": { "focus": "THYROID", "name": "Thyroid Support", "herbs": "Sea moss + Extra bladderwrack + Ashwagandha", "use_case": "Targeted iodine and adaptogens for thyroid and metabolism." } },
        { "type": "blend", "settings": { "focus": "DIGESTION", "name": "Digestion Blend", "herbs": "Sea moss + Ginger + Fennel", "use_case": "A calming gut blend \u2014 prebiotic fiber plus traditional digestive herbs." } },
        { "type": "blend", "settings": { "focus": "MEN", "name": "Men's Formula", "herbs": "Sea moss + Tribulus + Maca", "use_case": "A men's wellness blend for stamina, vitality, and daily drive." } },
