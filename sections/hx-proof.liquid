{{ 'section-homepage-healistix.css' | asset_url | stylesheet_tag }}

<div class="hx-proof" style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="hx-proof__wrapper">
    <div class="hx-proof__stats">
      {% for block in section.blocks %}
        <div class="hx-proof__stat" {{ block.shopify_attributes }}>
          <div class="hx-proof__number">{{ block.settings.number }}</div>
          <div class="hx-proof__label">{{ block.settings.label }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Proof - Stats Bar",
  "class": "section-hx-proof",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "460+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Happy Customers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Proof - Stats Bar",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "460+",
            "label": "Happy Customers"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "30+",
            "label": "5-Star Reviews"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "3",
            "label": "Award Wins"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "0",
            "label": "Bad Ingredients"
          }
        }
      ]
    }
  ]
}
{% endschema %}
