{{ 'section-homepage-healistix.css' | asset_url | stylesheet_tag }}

<div class="hx-reviews hx-reviews--wrapper" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="hx-reviews__container">
    {% if section.settings.eyebrow != blank %}
      <div class="hx-reviews__eyebrow">
        {{ section.settings.eyebrow }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="hx-reviews__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="hx-reviews__grid">
      {% for block in section.blocks %}
        {% if block.type == "review" %}
          <div class="hx-reviews__card" {{ block.shopify_attributes }}>
            <div class="hx-reviews__stars">
              {% for i in (1..5) %}
                {% if i <= block.settings.stars %}
                  <span class="hx-reviews__star hx-reviews__star--filled">★</span>
                {% else %}
                  <span class="hx-reviews__star">☆</span>
                {% endif %}
              {% endfor %}
            </div>

            <blockquote class="hx-reviews__text">
              "{{ block.settings.text }}"
            </blockquote>

            {% if block.settings.author != blank %}
              <p class="hx-reviews__author">
                — {{ block.settings.author }}
              </p>
            {% endif %}

            {% if block.settings.product_name != blank %}
              <p class="hx-reviews__product">
                {{ block.settings.product_name }}
              </p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 40,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews"
    }
  ]
}
{% endschema %}
