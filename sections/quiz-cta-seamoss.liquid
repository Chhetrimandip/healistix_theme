      "default": "TAKE THE QUIZ"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "person_image",
      "label": "Person Image (Front)"
    },
    {
      "type": "checkbox",
      "id": "show_top_badges",
      "label": "Show top badge bar",
      "default": true
    },
    {
      "type": "html",
      "id": "top_badges",
