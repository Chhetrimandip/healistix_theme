      "default": "GLUTEN FREE <span>+</span> 100% VEGAN <span>+</span> NON GMO <span>+</span> DAIRY FREE <span>+</span> SOY FREE <span>+</span> PALEO DIET <span>+</span> GLUTEN FREE <span>+</span> 100% VEGAN <span>+</span> NON GMO <span>+</span> DAIRY FREE"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
