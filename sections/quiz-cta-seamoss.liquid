{{ 'section-quiz-cta-seamoss.css' | asset_url | stylesheet_tag }}

<div id="QuizCTA-{{ section.id }}" class="quiz-cta-seamoss color-{{ section.settings.color_scheme }}">
  {%- if section.settings.show_top_badges -%}
    <div class="quiz-cta-seamoss__top-badges">
      <div class="quiz-cta-seamoss__badges-scroll">
        {{ section.settings.top_badges }}
        {{ section.settings.top_badges }}
      </div>
    </div>
  {%- endif -%}
  
  <div class="quiz-cta-seamoss__container">
    <div class="quiz-cta-seamoss__products-wrapper">
      <!-- Top Row - Scrolls Right to Left -->
      <div class="quiz-cta-seamoss__products-row quiz-cta-seamoss__products-row--top">
        <div class="quiz-cta-seamoss__products-track">
          {%- for i in (1..2) -%}
            {%- for block in section.blocks limit: 10 -%}
              <div class="quiz-cta-seamoss__product-card" {{ block.shopify_attributes }}>
                {%- if block.settings.product_image != blank -%}
                  <img src="{{ block.settings.product_image | image_url: width: 300 }}" 
                       alt="Product"
                       class="quiz-cta-seamoss__product-image"
                       loading="lazy">
                {%- else -%}
                  <div class="quiz-cta-seamoss__product-placeholder">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
      
      <!-- Bottom Row - Scrolls Left to Right -->
      <div class="quiz-cta-seamoss__products-row quiz-cta-seamoss__products-row--bottom">
        <div class="quiz-cta-seamoss__products-track quiz-cta-seamoss__products-track--reverse">
          {%- for i in (1..2) -%}
            {%- for block in section.blocks offset: 10 -%}
              <div class="quiz-cta-seamoss__product-card" {{ block.shopify_attributes }}>
                {%- if block.settings.product_image != blank -%}
                  <img src="{{ block.settings.product_image | image_url: width: 300 }}" 
                       alt="Product"
                       class="quiz-cta-seamoss__product-image"
                       loading="lazy">
                {%- else -%}
                  <div class="quiz-cta-seamoss__product-placeholder">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
    
    <div class="quiz-cta-seamoss__content">
      <div class="quiz-cta-seamoss__text-content">
        {%- if section.settings.heading != blank -%}
          <h2 class="quiz-cta-seamoss__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        
        {%- if section.settings.subheading != blank -%}
          <p class="quiz-cta-seamoss__subheading">
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}
        
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="quiz-cta-seamoss__button">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
      
      {%- if section.settings.person_image != blank -%}
        <div class="quiz-cta-seamoss__person">
          <img src="{{ section.settings.person_image | image_url: width: 800 }}" 
               alt="Person thinking"
               class="quiz-cta-seamoss__person-image"
               loading="lazy">
        </div>
      {%- else -%}
        <div class="quiz-cta-seamoss__person-placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'quiz-cta-seamoss__person-placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  #QuizCTA-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Quiz CTA Sea Moss",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thinking on which one to choose?"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get Your Personalized Recommendations!"
    },
    {
      "type": "text",
      "id": "button_label",
