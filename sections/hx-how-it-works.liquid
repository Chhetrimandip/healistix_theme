{% comment %}
  How It Works Section
  - 3-step process with numbered circles
  - Customizable eyebrow, heading, and step details
{% endcomment %}

<link rel="stylesheet" href="{{ 'section-homepage-healistix.css' | asset_url }}">

<div class="hx-how-it-works" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="hx-how-it-works__container">
    {% if section.settings.eyebrow %}
      <div class="hx-how-it-works__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading %}
      <h2 class="hx-how-it-works__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="hx-how-it-works__steps">
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          <div class="hx-how-it-works__step" {{ block.shopify_attributes }}>
            <div class="hx-how-it-works__step-number">{{ block.settings.number }}</div>
            <h3 class="hx-how-it-works__step-title">{{ block.settings.title }}</h3>
            <p class="hx-how-it-works__step-description">{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "3 Simple Steps"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Step Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Step description goes here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "1",
            "title": "Select Your Products",
            "description": "Browse our curated collection and choose products that match your wellness goals."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "2",
            "title": "Customize Your Plan",
            "description": "Tailor your selection with our easy customization options for your unique needs."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "3",
            "title": "Start Your Journey",
            "description": "Begin your wellness journey with fast shipping and our satisfaction guarantee."
          }
        }
      ]
    }
  ]
}
{% endschema %}
