{{ 'section-product-seamoss.css' | asset_url | stylesheet_tag }}
{{ 'hx-review-stories.css' | asset_url | stylesheet_tag }}

<div id="ProductReviewsGrid-{{ section.id }}" class="product-reviews-grid hx-review-stories">
  <div class="page-width">
    <div class="product-reviews-grid__header" id="customer-voices">
      <p class="hx-review-stories__eyebrow">CUSTOMER VOICES</p>
      <h2 class="product-reviews-grid__title">{{ section.settings.heading }}</h2>
      <p class="product-reviews-grid__subtitle">{{ section.settings.subheading }}</p>
    </div>
    <div class="product-reviews-grid__items">
      {%- for block in section.blocks limit: 6 -%}
        {% render 'hx-review-card', block: block %}
      {%- endfor -%}
    </div>
    {% if section.blocks.size > 6 %}
      <details class="hx-review-stories__more">
        <summary>See {{ section.blocks.size | minus: 6 }} more customer reviews</summary>
        <div class="product-reviews-grid__items">
          {% for block in section.blocks offset: 6 %}
            {% render 'hx-review-card', block: block %}
          {% endfor %}
        </div>
      </details>
    {% endif %}
    <div class="hx-review-stories__source-row">
      <p>Selected customer reviews, not the full review collection. The flavor is shown on each card{% if request.page_type == 'product' %} and may differ from your selection above{% endif %}. Individual experiences vary.</p>
    {%- if section.settings.source_url != blank -%}
      <a class="hx-review-source" href="{{ section.settings.source_url }}" target="_blank" rel="noopener">Read more customer reviews ↗</a>
    {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Reviews Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Customer experiences"},
    {"type": "text", "id": "subheading", "label": "Subheading"},
    {"type": "url", "id": "source_url", "label": "Amazon reviews link"}
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {"type": "text", "id": "badge", "label": "Reviewer display name"},
        {"type": "text", "id": "rating", "label": "Original rating"},
        {"type": "text", "id": "title", "label": "Editorial topic heading (not a quote)"},
        {"type": "textarea", "id": "text", "label": "Verified review excerpt"},
        {"type": "text", "id": "footer", "label": "Source, flavor and review date"},
        {"type": "text", "id": "video_asset", "label": "Original customer video asset filename"},
        {"type": "text", "id": "image_asset", "label": "Customer photo or video poster asset filename"},
        {"type": "text", "id": "captions_asset", "label": "English captions asset filename"},
        {"type": "text", "id": "media_alt", "label": "Customer photo description"},
        {"type": "text", "id": "disclosure", "label": "Original source disclosure"},
        {"type": "url", "id": "source_url", "label": "Original review URL"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Reviews Grid",
      "blocks": []
    }
  ]
}
{% endschema %}
