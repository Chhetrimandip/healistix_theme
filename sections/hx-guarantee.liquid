{{ 'section-homepage-healistix.css' | asset_url | stylesheet_tag }}

<div class="hx-guarantee" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="hx-guarantee__container">
    <div class="hx-guarantee__grid">
      {% for block in section.blocks %}
        {% if block.type == 'pledge' %}
          <div class="hx-guarantee__item" {{ block.shopify_attributes }}>
            <div class="hx-guarantee__icon">{{ block.settings.icon }}</div>
            <div class="hx-guarantee__text">
              <strong class="hx-guarantee__title">{{ block.settings.title }}</strong>
              <span class="hx-guarantee__detail">{{ block.settings.detail }}</span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Guarantee Bar",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0, "max": 100, "step": 10, "default": 40, "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0, "max": 100, "step": 10, "default": 40, "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "pledge",
      "name": "Pledge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "🛡️" },
        { "type": "text", "id": "title", "label": "Title", "default": "30-Day Guarantee" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Full refund, no questions asked" }
      ]
    }
  ],
  "presets": [{ "name": "Guarantee Bar" }]
}
{% endschema %}
