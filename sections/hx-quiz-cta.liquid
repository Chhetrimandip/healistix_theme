{{ 'section-homepage-healistix.css' | asset_url | stylesheet_tag }}

<div class="hx-quiz" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="hx-quiz__container">
    <div class="hx-quiz__card">
      <div class="hx-quiz__header">
        {% if section.settings.eyebrow != blank %}
          <div class="hx-quiz__eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}

        <h2 class="hx-quiz__heading">{{ section.settings.heading }}</h2>

        {% if section.settings.subtitle != blank %}
          <p class="hx-quiz__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>

      <div class="hx-quiz__steps">
        {% for block in section.blocks %}
          {% if block.type == 'quiz_step' %}
            <div class="hx-quiz__step" {{ block.shopify_attributes }}>
              <div class="hx-quiz__step-number">{{ block.settings.number }}</div>
              <div class="hx-quiz__step-content">
                <h3 class="hx-quiz__step-title">{{ block.settings.title }}</h3>
                <p class="hx-quiz__step-desc">{{ block.settings.description }}</p>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="hx-quiz__cta-area">
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="hx-quiz__button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}

        {% if section.settings.time_note != blank %}
          <p class="hx-quiz__time-note">{{ section.settings.time_note }}</p>
        {% endif %}
      </div>

      {% if section.settings.social_proof != blank %}
        <div class="hx-quiz__social-proof">{{ section.settings.social_proof }}</div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Quiz CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Personalized for You" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not Sure Where to Start?" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "With 30+ blends, picking the right one can feel overwhelming. Our quiz matches you to the perfect blend for your body and goals." },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Find Your Perfect Blend" },
    { "type": "url", "id": "button_link", "label": "Button Link" },
    { "type": "text", "id": "time_note", "label": "Time Note", "default": "Takes 60 seconds · No email required" },
    { "type": "text", "id": "social_proof", "label": "Social Proof", "default": "12,000+ blends matched so far" },
    { "type": "text", "id": "icon", "label": "Icon (legacy)", "default": "🔍" },
    { "type": "textarea", "id": "description", "label": "Description (legacy)" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0, "max": 100, "step": 10, "default": 80, "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0, "max": 100, "step": 10, "default": 80, "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "quiz_step",
      "name": "Quiz Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Step Number", "default": "1" },
        { "type": "text", "id": "title", "label": "Title", "default": "Tell Us Your Goal" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Energy, skin, hair, immunity, gut health — what matters most to you?" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quiz CTA",
      "blocks": [
        { "type": "quiz_step", "settings": { "number": "1", "title": "Tell Us Your Goal", "description": "Energy, skin, hair, immunity, gut health — what matters most?" } },
        { "type": "quiz_step", "settings": { "number": "2", "title": "We Match Your Blend", "description": "Our algorithm picks from 30+ blends based on your answers." } },
        { "type": "quiz_step", "settings": { "number": "3", "title": "Feel the Difference", "description": "Most customers notice a change within 2 weeks of daily use." } }
      ]
    }
  ]
}
{% endschema %}
