        <article class="product-reviews-grid__item" {{ block.shopify_attributes }}>
          <div class="product-reviews-grid__badge">{{ block.settings.badge }}</div>
          {%- if block.settings.video_asset != blank -%}
            <div class="hx-review-stories__media">
              <video controls playsinline preload="none" poster="{{ block.settings.image_asset | asset_url }}" aria-label="Customer video by {{ block.settings.badge | escape }}">
                <source src="{{ block.settings.video_asset | asset_url }}" type="video/mp4">
                {%- if block.settings.captions_asset != blank -%}
                  <track kind="captions" src="{{ block.settings.captions_asset | asset_url }}" srclang="en" label="English" default>
                {%- endif -%}
                <a href="{{ block.settings.video_asset | asset_url }}">Watch the customer video</a>
              </video>
            </div>
          {%- elsif block.settings.image_asset != blank -%}
            <a class="hx-review-stories__media" href="{{ block.settings.image_asset | asset_url }}" target="_blank" rel="noopener">
              <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.media_alt | escape }}" width="720" height="960" loading="lazy">
            </a>
          {%- endif -%}
          {%- if block.settings.rating != blank -%}
          <div class="product-reviews-grid__rating">{{ block.settings.rating }}</div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="hx-review-stories__card-title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <blockquote class="product-reviews-grid__text">“{{ block.settings.text | escape }}”</blockquote>
          {%- endif -%}
          <div class="product-reviews-grid__footer">{{ block.settings.footer }}</div>
          
          {%- if block.settings.source_url != blank -%}
            <a href="{{ block.settings.source_url }}" target="_blank" rel="noopener">Read original review ↗</a>
          {%- endif -%}
        </article>
