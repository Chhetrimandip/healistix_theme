{% comment %}Real Shopify selling plans only. No placeholder prices or plan IDs.{% endcomment %}
<script type="application/json" data-hx-subscription-data>
{
  "variants": {
    {% for variant in product.variants %}
      "{{ variant.id }}": {
        "required": {{ variant.requires_selling_plan | json }},
        "plans": [
          {% for allocation in variant.selling_plan_allocations %}
            {"id": {{ allocation.selling_plan.id | append: '' | json }}, "price": {{ allocation.price | json }}}
            {% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  }
}
</script>
{% if product.selling_plan_groups.size > 0 %}
  <fieldset class="hx-subscription-options" data-hx-subscriptions>
    <legend data-hx-offer-title>Subscribe &amp; save</legend>
    <div class="hx-subscription-value" data-hx-offer hidden aria-live="polite">
      <strong data-hx-offer-price></strong>
      <span data-hx-offer-saving></span>
      <p>Keep your routine stocked with automatic deliveries.</p>
      <ul class="hx-subscription-perks" aria-label="Subscription benefits">
        <li>
          <span class="hx-subscription-perks__art hx-subscription-perks__art--save">
            <svg viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false"><path d="M12 18h27l14 14-25 25L7 36V23a5 5 0 0 1 5-5Z" fill="#fffaf0" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><circle cx="18" cy="28" r="3" fill="currentColor"/><path d="m27 43 11-15" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><circle cx="28" cy="31" r="2.5" stroke="currentColor" stroke-width="2"/><circle cx="38" cy="41" r="2.5" stroke="currentColor" stroke-width="2"/><path d="m46 9 2-5m6 13 5-2" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          </span>
          <strong>Subscriber price</strong><span>More value per jar</span>
        </li>
        <li>
          <span class="hx-subscription-perks__art hx-subscription-perks__art--delivery">
            <svg viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false"><rect x="11" y="14" width="42" height="40" rx="6" fill="#fffaf0" stroke="currentColor" stroke-width="2.5"/><path d="M11 26h42M22 9v11M42 9v11" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M40 37a10 10 0 1 0 0 10m0-10v7h-7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <strong>On your schedule</strong><span>Automatic deliveries</span>
        </li>
        <li>
          <span class="hx-subscription-perks__art hx-subscription-perks__art--jar">
            <svg viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false"><rect x="19" y="11" width="27" height="8" rx="3" fill="#efd381" stroke="currentColor" stroke-width="2.5"/><rect x="16" y="20" width="33" height="35" rx="8" fill="#fffaf0" stroke="currentColor" stroke-width="2.5"/><path d="M17 30h31v17H17" fill="#e2ebd1"/><path d="M29 42c-5-9 3-11 9-10 1 7-2 13-9 10Zm0 0-3 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="m8 18-3-3m48 10 5-2" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          </span>
          <strong>Routine, restocked</strong><span>One less thing to order</span>
        </li>
      </ul>
    </div>
    <label for="HxPurchase-{{ section.id }}">Purchase option</label>
    <select id="HxPurchase-{{ section.id }}" name="selling_plan" data-hx-plan>
      {% unless product.requires_selling_plan %}<option value="">One-time purchase</option>{% endunless %}
      {% for group in product.selling_plan_groups %}
        {% for plan in group.selling_plans %}
          {% if plan.recurring_deliveries %}
            <option value="{{ plan.id }}">{{ plan.name | escape }}</option>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </select>
    <p data-hx-plan-note aria-live="polite">Choose a subscription delivery option or buy once.</p>
  </fieldset>
{% endif %}
