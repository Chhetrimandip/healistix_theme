{%- comment -%}2025 fronts with legacy side labels, approved as equivalent by the merchant.{%- endcomment -%}
<hx-jar-viewer hidden
  data-library="{{ 'hx-three.module.js' | asset_url }}"
  data-scene="{{ 'hx-jar-scene.js' | asset_url }}"
  data-front="{{ 'hx-label-banana-front.webp' | asset_url }}"
  data-right="{{ 'hx-label-banana-right.webp' | asset_url }}"
  data-left="{{ 'hx-label-banana-left.webp' | asset_url }}"
  data-unwrapped="true">
  <script type="application/json" data-jar-sources>{
"passion fruit": {"front": {{ 'hx-label-passion-fruit-front.webp' | asset_url | json }}, "right": {{ 'hx-label-passion-fruit-right.webp' | asset_url | json }}, "left": {{ 'hx-label-passion-fruit-left.webp' | asset_url | json }}, "color": "#f0ca3b", "unwrapped": true},
