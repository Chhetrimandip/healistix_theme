"peach": {"front": {{ 'hx-label-peach-front.webp' | asset_url | json }}, "right": {{ 'hx-label-peach-right.webp' | asset_url | json }}, "left": {{ 'hx-label-peach-left.webp' | asset_url | json }}, "color": "#ddaa27", "unwrapped": true},
"blueberry": {"front": {{ 'hx-label-blueberry-front.webp' | asset_url | json }}, "right": {{ 'hx-label-blueberry-right.webp' | asset_url | json }}, "left": {{ 'hx-label-blueberry-left.webp' | asset_url | json }}, "color": "#263b72", "unwrapped": true},
"strawberry": {"front": {{ 'hx-label-strawberry-front.webp' | asset_url | json }}, "right": {{ 'hx-label-strawberry-right.webp' | asset_url | json }}, "left": {{ 'hx-label-strawberry-left.webp' | asset_url | json }}, "color": "#ab2711", "unwrapped": true},
"watermelon": {"front": {{ 'hx-label-watermelon-front.webp' | asset_url | json }}, "right": {{ 'hx-label-watermelon-right.webp' | asset_url | json }}, "left": {{ 'hx-label-watermelon-left.webp' | asset_url | json }}, "color": "#ed663e", "unwrapped": true},
"unflavored": {"front": {{ 'hx-label-unflavored-front.webp' | asset_url | json }}, "right": {{ 'hx-label-unflavored-right.webp' | asset_url | json }}, "left": {{ 'hx-label-unflavored-left.webp' | asset_url | json }}, "color": "#cac7a9", "unwrapped": true},
"mango": {"front": {{ 'hx-label-mango-front.webp' | asset_url | json }}, "right": {{ 'hx-label-mango-right.webp' | asset_url | json }}, "left": {{ 'hx-label-mango-left.webp' | asset_url | json }}, "color": "#f2bb2e", "unwrapped": true},
"dragonfruit": {"front": {{ 'hx-label-dragonfruit-front.webp' | asset_url | json }}, "right": {{ 'hx-label-dragonfruit-right.webp' | asset_url | json }}, "left": {{ 'hx-label-dragonfruit-left.webp' | asset_url | json }}, "color": "#b93e3d", "unwrapped": true},
"pineapple": {"front": {{ 'hx-label-pineapple-front.webp' | asset_url | json }}, "right": {{ 'hx-label-pineapple-right.webp' | asset_url | json }}, "left": {{ 'hx-label-pineapple-left.webp' | asset_url | json }}, "color": "#e7c52c", "unwrapped": true},
"strawberry pineapple": {"front": {{ 'hx-label-strawberry-pineapple-front.webp' | asset_url | json }}, "right": {{ 'hx-label-strawberry-pineapple-right.webp' | asset_url | json }}, "left": {{ 'hx-label-strawberry-pineapple-left.webp' | asset_url | json }}, "color": "#ffbe05", "unwrapped": true},
"grape": {"front": {{ 'hx-label-grape-front.webp' | asset_url | json }}, "right": {{ 'hx-label-grape-right.webp' | asset_url | json }}, "left": {{ 'hx-label-grape-left.webp' | asset_url | json }}, "color": "#753954", "unwrapped": true},
"banana": {"front": {{ 'hx-label-banana-front.webp' | asset_url | json }}, "right": {{ 'hx-label-banana-right.webp' | asset_url | json }}, "left": {{ 'hx-label-banana-left.webp' | asset_url | json }}, "color": "#e3dc9b", "unwrapped": true},
"maca ashwagandha": {"front": {{ 'hx-label-maca-ashwagandha-front.webp' | asset_url | json }}, "right": {{ 'hx-label-maca-ashwagandha-right.webp' | asset_url | json }}, "left": {{ 'hx-label-maca-ashwagandha-left.webp' | asset_url | json }}, "color": "#c0af7a", "unwrapped": true, "lidColor": "#232323"},
"ashwagandha mango": {"front": {{ 'hx-label-ashwagandha-mango-front.webp' | asset_url | json }}, "right": {{ 'hx-label-ashwagandha-mango-right.webp' | asset_url | json }}, "left": {{ 'hx-label-ashwagandha-mango-left.webp' | asset_url | json }}, "color": "#c09c1f", "unwrapped": true, "lidColor": "#232323"},
"elderberry ginger": {"front": {{ 'hx-label-elderberry-ginger-front.webp' | asset_url | json }}, "right": {{ 'hx-label-elderberry-ginger-right.webp' | asset_url | json }}, "left": {{ 'hx-label-elderberry-ginger-left.webp' | asset_url | json }}, "color": "#4e4258", "unwrapped": true, "lidColor": "#232323"},
"honey": {"front": {{ 'hx-label-honey-front.webp' | asset_url | json }}, "right": {{ 'hx-label-honey-right.webp' | asset_url | json }}, "left": {{ 'hx-label-honey-left.webp' | asset_url | json }}, "color": "#c0a85d", "unwrapped": true, "lidColor": "#232323"}
}</script>
  <div class="hx-jar-canvas" tabindex="0" role="region" aria-label="Banana jar. Drag horizontally or use arrow keys to rotate. Plus and minus zoom."></div>
  <p class="hx-jar-status" role="status">Getting your jar ready…</p>
  <div class="hx-jar-toolbar" role="group" aria-label="Jar controls">
    <button type="button" data-jar-action="left" aria-label="Rotate left">←</button>
    <button type="button" data-jar-action="front">Front</button>
    <button type="button" data-jar-action="label">Label</button>
    <button type="button" data-jar-action="directions">Directions</button>
    <button type="button" data-jar-action="right" aria-label="Rotate right">→</button>
    <button type="button" data-jar-action="in" aria-label="Zoom in">+</button>
    <button type="button" data-jar-action="out" aria-label="Zoom out">−</button>
    <button type="button" data-jar-action="reset" aria-label="Reset view">↺</button>
  </div>
  <span class="hx-jar-angle" aria-hidden="true">0°</span>
</hx-jar-viewer>
